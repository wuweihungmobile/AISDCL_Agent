{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "monorepo 整合層 — 守衛式 SDD hook 橋接（AutoSDD_improving）。以 SDD_ACTIVE_VERSION 為守衛路由到 AISDLC_SDD/AISDLC_SDD_v0.0X 的實體 hooks；未設則 no-op，純 AutoClaude session 零污染。詳見 .claude/hooks/sdd_hook_router.py。hook command 用相對路徑（勿用 ${CLAUDE_PROJECT_DIR}：Windows cmd 不展開變數）；前提＝claude 於 monorepo 根目錄啟動（cwd=專案根，見 ONBOARDING §4）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/sdd_hook_router.py session_start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Read|Bash|NotebookEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/sdd_hook_router.py context_ledger_pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Read|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/sdd_hook_router.py context_ledger_post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python AutoClaude/tools/hooks/check_ps1_encoding.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
