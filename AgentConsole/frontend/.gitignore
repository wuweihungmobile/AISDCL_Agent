# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（範本 .env.example 入庫，實際 .env* 不入庫；根 .gitignore 的 .env.* 在此以否定規則放行範本）
.env*
!.env.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
