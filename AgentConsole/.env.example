# .env.example — Docker Compose 環境變數模板（PRD §11.6）
# 使用：cp .env.example .env，再把所有 <YOUR_...> 換成實際值。.env 不可提交至版本控制（.gitignore 已排除）。
# 🔴 這個檔只放佔位符；真實密碼與金鑰絕不可寫進任何入庫檔案。
# 🔴 Compose 會展開值內的 $：密碼或雜湊含 $ 時要寫成 $$。

# ── Compose profiles ──
# db＝資料庫層｜app＝frontend／backend／engine-bridge｜full＝nginx（每個服務都屬於某個 profile）。
# 指令一律明確帶 --profile（docker/README.md 的所有指令皆如此）：資料庫層 `--profile db`、全棧
# `--profile db --profile app --profile full`。
# 想讓裸的 `docker compose up -d` 就起資料庫層，可取消下一行註解；但這樣獨立使用 docker-compose.dev.yml
# （只起 postgres-primary＋redis）時會連 replica 一起帶起來，所以預設保持註解。
# COMPOSE_PROFILES=db

# ── PostgreSQL ──
POSTGRES_DB=aisdlc
POSTGRES_USER=aisdlc
POSTGRES_PASSWORD=<YOUR_STRONG_PASSWORD>
# backend／engine-bridge 連的資料庫主機（compose 服務名）。手動 failover 後改成 postgres-replica 再重建這兩個容器
POSTGRES_HOST=postgres-primary
# 正式模式（docker-compose.yml）不對主機發布 PG／Redis 埠；以下埠只在使用 docker-compose.dev.yml 時生效
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
# 疊加檔把埠綁在哪個主機位址；預設只綁本機迴路（Redis 沒有密碼，勿綁對外位址）
DEV_BIND_ADDR=127.0.0.1
# 串流複製專用帳號 replicator 的密碼
REPLICATION_PASSWORD=<YOUR_REPLICATION_PASSWORD>

# ── Application ──
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=<YOUR_JWT_SECRET_MIN_32_CHARS>
# 敏感系統參數的 AES-256 金鑰（Architecture §9.4）
CONSOLE_ENCRYPTION_KEY=<YOUR_CONSOLE_ENCRYPTION_KEY>
# 後端 origin（不含 /api/v1）。全棧經 nginx 同源時必須留空（ADR-001 D14-12：填 /api 會疊成 /api/api/v1）；
# 前端在主機單獨跑時才填 http://localhost:8080。
NEXT_PUBLIC_API_URL=
# 使用者密碼的 BCrypt 雜湊（admin／operator／viewer）；未設定＝用 backend 的開發預設（backend/README.md），
# 正式環境必須覆寫。雜湊內的 $ 要寫成 $$，例如 $$2a$$10$$xxxxxxxx…
# CONSOLE_ADMIN_PASSWORD_HASH=<YOUR_BCRYPT_HASH_WITH_DOLLARS_ESCAPED>
# CONSOLE_OPERATOR_PASSWORD_HASH=<YOUR_BCRYPT_HASH_WITH_DOLLARS_ESCAPED>
# CONSOLE_VIEWER_PASSWORD_HASH=<YOUR_BCRYPT_HASH_WITH_DOLLARS_ESCAPED>

# ── Engine Bridge（單一旁車，path 前綴 /autoclaude /sdd 區分兩引擎）──
ENGINE_BRIDGE_URL=http://engine-bridge:8081
MINIMAX_API_KEY=<YOUR_MINIMAX_API_KEY>
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=abab6.5-chat

# ── pgAdmin ──
# 注意：pgAdmin 9 的 email 驗證拒絕 .local 這類保留網域（PRD 範例 admin@aisdlc.local 會讓容器起不來）
PGADMIN_EMAIL=admin@aisdlc.example.com
PGADMIN_PASSWORD=<YOUR_PGADMIN_PASSWORD>
PGADMIN_PORT=5050

# ── Grafana ──
GRAFANA_USER=admin
GRAFANA_PASSWORD=<YOUR_GRAFANA_PASSWORD>
GRAFANA_PORT=3001

# ── Prometheus ──
PROMETHEUS_PORT=9090

# ── pgBackRest ──
# repo1（本地）與 repo2（離站）共用的 AES-256 加密密碼：遺失＝所有備份無法還原，請另行保管
PGBACKREST_CIPHER_PASS=<YOUR_PGBACKREST_CIPHER_PASS>
# cron 排程（PRD：週日 02:00 全備…）所用的時區
BACKUP_TZ=Asia/Taipei
# 每日 pg_dump 邏輯離站備份的保留天數（與 repo 的 28 天對齊）
LOGICAL_BACKUP_RETENTION_DAYS=28

# ── 離站備份（repo2＋pg_dump）：預設指向 compose 內的 MinIO；改用真 S3 只要改這一段 ──
# 本機 MinIO：endpoint＝minio:9000、region 任意（用 us-east-1）、uri-style＝path、verify-tls＝n（自簽憑證）。
# AWS S3：endpoint＝s3.amazonaws.com、region＝你的 region（例 ap-northeast-1）、uri-style＝host、verify-tls＝y。
PGBACKREST_S3_BUCKET=aisdlc-db-backup
PGBACKREST_S3_ENDPOINT=minio:9000
PGBACKREST_S3_REGION=us-east-1
PGBACKREST_S3_URI_STYLE=path
PGBACKREST_S3_VERIFY_TLS=n
# pgBackRest 與 pg_dump 使用的 S3 金鑰。本機 MinIO：minio-init 會用它們建立「只能存取該 bucket」的專用帳號
# （access key ≥ 3 字元、secret ≥ 8 字元）；真 S3：填 IAM 使用者金鑰。
AWS_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_KEY>

# ── MinIO（本機離站儲存）root 帳號：只給 MinIO 本身與 minio-init 用（secret ≥ 8 字元）──
# 🔴 MINIO_ROOT_USER 必須與上方 AWS_ACCESS_KEY_ID 不同：minio-init 會以 AWS_ACCESS_KEY_ID 建立備份專用帳號，與 root 同名會失敗（退出 1）而連帶 pgbackrest 不啟動
MINIO_ROOT_USER=<YOUR_MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<YOUR_MINIO_ROOT_PASSWORD>
