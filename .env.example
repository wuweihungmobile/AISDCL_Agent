# ── 額度水位節流：**本檔是範例（.env.example，生成物）**；共享參數住 repo 根 env.shared ──
#    【重要】新機器**不需要** .env：env.shared（git 追蹤）pull 即同步。只有「本機要與共享
#    不同」才建 .env，且**只寫要偏離的那幾行**；不要整份複製本檔——每一行都會遮住 env.shared。
# 🔴 唯一的家＝tools/lib/quota_policy.py 的 ENV_SPEC；本檔是生成物，勿手寫：
#    python tools/lib/quota_policy.py --print-env-example
# 載入鏈（高→低）：**行程 env > AutoClaude/.env > 根 .env > 根 env.shared > 出廠預設**：
#   ① 根 env.shared    —— 追蹤、跨機同步；「刻意偏離出廠值」的決策與理由住這裡。
#   ② 根 .env          —— 本機專屬（gitignored）、可空可缺；harness 的 hook 讀
#      （tools/lib/quota_gate.py:policy_env）。下方**逃生口那一區也算數**（hook main() 先把
#      這些鍵填成行程級預設，缺席才填）。`KEY=` 留空＝沒設，不會遮住下一層。
#   ③ AutoClaude/.env  —— 引擎側讀（autoclaude/utils/config.py:_quota_env）；同名鍵覆寫
#      ①②。引擎只讀 3 個鍵（CONVERGE_PCT／HALT_PCT／DEGRADED_CAP），harness 完全不讀它。
#   ④ .claude/settings.json 的 env 區塊 —— **會**注入 hook 行程（實測：把
#      SDD_ROUTER_QUIET=1 放進去，SessionStart 的 SDD-ROUTER 由 4 行變 0 行）；
#      它等同行程 env，贏過上面全部檔案。
# 維護：python tools/lib/quota_policy.py --env-doctor [--fix]（點名遮蔽／多餘／打錯字的行）。
# 行內註解（值後面接 ` # …`）會被剝掉 ⇒ 手寫時可以加註解；本機刻意覆寫請在行尾加
# `# override-ok: <WHY>`（doctor 與引擎的分歧警告都認這個標記）。
# 開始注意、少派（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_NOTICE_PCT=50
# 開始收斂（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CONVERGE_PCT=70
# 準備下一次 Reset（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PREPARE_PCT=85
# 停止並喚醒下一輪（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_HALT_PCT=95
# reset 在這麼近之內 ⇒ 加速（使用者原文的 30m）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_ACCEL_WINDOW_MINUTES=30
# 超過這麼遠 ⇒ 減速（6h）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_FAR_HORIZON_MINUTES=360
# 一次 /compact 預估消耗的額度百分點（PRD §4.3；須 < prepare − converge）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_COMPACT_COST_BUDGET_PP=3
# 收尾保留段：進 cap 聚合的軸剩餘分鐘低於此值 ⇒ 建議派工數收到 cap_prepare（出廠＝一個扇出視窗；須 < accel_window）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_WRAP_MINUTES=5
# 配速床：窗初容許一波並行派工的 pp（允許線＝已過窗長比例×100＋此值；只准調小）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_BURST_PP=20
# 配速床：超線超過此 pp ⇒ 水位抬到 prepare、否則 converge（只准調小）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_STEP_PP=10
# 趕工戳記到期時刻（epoch 秒；由 sessionctl rush 經 policy_env 疊入，勿手寫常駐）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_RUSH_UNTIL=
# notice 帶的 base cap（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CAP_NOTICE=8
# converge 帶的 base cap（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CAP_CONVERGE=4
# prepare 帶的 base cap（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CAP_PREPARE=2
# reset 近在眼前時的**加速**倍率（下界 1＝不加速；R84／6b）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_NEAR=2
# reset 很遠／期程不明時的**減速**倍率（上界 1＝不減速；R84／6b）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_FAR=0.5
# 配速上限：PACE_INDEX 超過才判超前（1＝任何超前即減速；PRD §4.2.8）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_CEILING=1
# 加速後的絕對上界（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_MAX_FANOUT=16
# 量不到時的上限（絕不是「不設限」；≤ cap_prepare）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_DEGRADED_CAP=2
# 節流帶 cap 的**上限**覆寫（留空＝不覆寫）：只收緊不放寬，halt 帶不吃（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_FANOUT_CAP=
# 離開 unmeasured 前需連續幾次量得到（PRD §4.2.4(a)：≥2）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_AVAILABILITY_EXIT_STREAK=2
# 離開 unmeasured 前至少停留幾秒（不變式：QUOTA_CACHE_TTL_SECONDS ≤ 本值 ≤ SENTINEL_INTERVAL_SECONDS，PRD R15／R16；兩個常數的現查見那兩支檔）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_AVAILABILITY_MIN_DWELL_SECONDS=360
# 併發上限「增加」方向的最小停留時間（PRD §4.2.4(d)；「減少」方向不受此限）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_MIN_DWELL_SECONDS=300
# 喚醒選路：逐字稿超此位元組數即降級 FRESH（留空＝內建 32MiB）（範例值，可依帳號方案調整）
AUTOSDD_RESUME_MAX_TRANSCRIPT_BYTES=
# 【已退役】原 R1（25 萬換窗）；有設也不生效，換窗改由 HARD 硬線承接（範例值，可依帳號方案調整）
AUTOSDD_SWITCH_R1_CTX_TOKENS=
# 切新 session R2：逐字稿已壓縮達此次數 ⇒ 改開新 session（只准下修）（範例值，可依帳號方案調整）
AUTOSDD_SWITCH_R2_COMPACTIONS=2
# 【已退役】原 R3（上次續跑寫入快取達標即換新）；有設也不生效，由 F4 成本選路取代（範例值，可依帳號方案調整）
AUTOSDD_SWITCH_R3_CACHE_CREATION_TOKENS=
# 成本選路 F4：新 session 接手成本 F（加權單位；出廠＝實測中位 480,734 取整）。快取已冷時，同 session 續跑重寫（2.0×上下文）> F×(1+q) 即改開新 session（範例值，可依帳號方案調整）
AUTOSDD_SWITCH_FRESH_COST_UNITS=480000
# 成本選路 F4：上下文價值係數 q（失去上下文的品質損失＝q×F；0＝只看 token 成本，出廠 1.0＝治理決定）（範例值，可依帳號方案調整）
AUTOSDD_SWITCH_CONTEXT_VALUE_Q=1
# 過期 session：閒置達此小時數且同專案有更新的 session 做過事 ⇒ 不續跑、哨兵自我解除（範例值，可依帳號方案調整）
AUTOSDD_STALE_SESSION_HOURS=24
# 續棒成本閘：SendMessage 目標代理上下文達此 token 數 ⇒ 無人窗口阻斷；互動僅在其快取已冷時阻斷（只准下修）（範例值，可依帳號方案調整）
AUTOSDD_RESUME_AGENT_TOKENS=150000
# 換 session 硬線（唯一的上下文換窗線）：主控上下文達此 token 數 ⇒ 擋 Agent／Task／Workflow、回合結束推回封存一次、PostToolUse 出聲建議換窗（只准下修；須低於觀測到的流程內 autocompact 最小點 881,938）（範例值，可依帳號方案調整）
AUTOSDD_SWITCH_HARD_CTX_TOKENS=850000
# 交接包公告的存活小時數（逾時不再於 SessionStart 出聲）（範例值，可依帳號方案調整）
AUTOSDD_HANDOFF_TTL_HOURS=72
# 名冊：背景代理超過此分鐘數無新記錄 ⇒ 標為「安靜」（範例值，可依帳號方案調整）
AUTOSDD_ROSTER_QUIET_MINUTES=10
# 背景代理監督（sessionctl watch）：代理最後一筆記錄距今達此分鐘數 ⇒ 判停滯（下限 11＝前景工具逾時上限 10 分鐘＋餘裕，低於即退回出廠值）（範例值，可依帳號方案調整）
AUTOSDD_WATCH_STALL_MINUTES=15
# 背景代理監督：代理自啟動起達此分鐘數仍未交卷 ⇒ 判逾時（--wall-min 可逐次覆寫）（範例值，可依帳號方案調整）
AUTOSDD_WATCH_AGENT_WALL_MINUTES=120
# 背景代理監督：代理上下文達此 token 數 ⇒ 判預算超支（只准下修）（範例值，可依帳號方案調整）
AUTOSDD_WATCH_AGENT_CTX_TOKENS=700000
# 主控快取保溫（sessionctl keepwarm）：距主控最後一筆 assistant 記錄這麼多分鐘就叫醒一次（只准下修、下限 15；出廠 45＝早於閒置約 55 分的自動壓縮與 1 小時快取壽命）（範例值，可依帳號方案調整）
AUTOSDD_KEEPWARM_MINUTES=45
# 主控快取保溫：上下文低於此 token 數就不保溫（重寫很便宜，不值得叫醒）（範例值，可依帳號方案調整）
AUTOSDD_KEEPWARM_MIN_CTX_TOKENS=30000
# 額度牆：p(c) 每千單位耗的短窗 pp（一次保溫＝p(c)/1000×此值）；空＝未校準（範例值，可依帳號方案調整）
AUTOSDD_QUOTAWALL_PP_PER_KUNIT=
# 額度牆：偵測延遲內的燒速 pp／分；空＝未校準（1.0）（範例值，可依帳號方案調整）
AUTOSDD_QUOTAWALL_BURN_PP_PER_MIN=
# 額度牆：一支在飛代理收尾預估 pp；空＝未校準（5）（範例值，可依帳號方案調整）
AUTOSDD_QUOTAWALL_AGENT_EST_PP=
# 互動視窗自動切換 session：auto（出聲＋可 spawn）／notify（只出聲）／off（範例值，可依帳號方案調整）
AUTOSDD_SESSION_SWITCH_MODE=auto
# 接力：每個 reset 視窗最多自動續跑幾次（出廠 2）（範例值，可依帳號方案調整）
AUTOSDD_RELAY_MAX_SPAWNS=2
# 接力：連續幾窗零新進度即停止（出廠 1＝零推進即停，對齊 R112 語意）（範例值，可依帳號方案調整）
AUTOSDD_RELAY_NO_PROGRESS_LIMIT=1
# 無人喚醒窗口（續跑）的主控模型，別名或完整 id；留空＝不帶 --model、沿用存檔／設定鏈（範例值，可依帳號方案調整）
AUTOSDD_MODEL_HELMSMAN=
# 子代理預設模型：喚醒窗口注入 CLAUDE_CODE_SUBAGENT_MODEL；--pace／SessionStart 簡報印出供派工明寫 model:（呼叫時明寫的 model 仍優先）。填 inherit＝不注入（行程既有的 CLAUDE_CODE_SUBAGENT_MODEL 原樣保留）（範例值，可依帳號方案調整）
AUTOSDD_MODEL_SUBAGENT=sonnet
# 降級建議的第二階模型，同時是額度付費探針（--probe-quota）用的模型（範例值，可依帳號方案調整）
AUTOSDD_MODEL_DOWNGRADE=haiku

# ── 既有逃生口（此前只散落在 hook 註解裡，零使用者可讀清單）──
# 1 ⇒ 額度節流全關
AUTOSDD_QUOTA_GUARD_OFF=
# 1 ⇒ 額度續航哨兵關掉
AUTOSDD_SENTINEL_OFF=
# 1 ⇒ context 阻斷關掉（**與上一個不同的東西**）
AUTOSDD_CONTEXT_GUARD_OFF=
# 1 ⇒ 只關送達面
AUTOSDD_CONTEXT_SIGNAL_OFF=
# 1 ⇒ 醒來只探測＋留痕，不自動續跑（session_resume_planner.py 專屬）
AUTOSDD_RESUME_OFF=
# 1 ⇒ 清倉授權（操作者落款）全部失效；只准關不准開（quota_burndown.py 專屬）
AUTOSDD_QUOTA_BURNDOWN_OFF=
# 1 ⇒ 只關主控快取保溫（Stop 保溫閘與 keepwarm 指令；sessionctl 專屬）
AUTOSDD_KEEPWARM_OFF=
