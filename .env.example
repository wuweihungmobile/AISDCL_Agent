# ── 額度水位節流：**本檔是範例（.env.example）；實際生效的是 repo 根的 .env** ──
#    用法：copy .env.example .env（原封不動複製即可用），再改你要的那幾個值。
# 🔴 唯一的家＝tools/lib/quota_policy.py 的 ENV_SPEC；本檔是生成物，勿手寫：
#    python tools/lib/quota_policy.py --print-env-example
# 生效路徑三條，優先序 **env > AutoClaude/.env > 根 .env > 出廠預設**：
#   ① repo 根 .env      —— harness 的 hook 讀（tools/lib/quota_gate.py:policy_env）；
#      下方**逃生口那一區也算數**（hook main() 先把這些鍵填成行程級預設，缺席才填）。
#      🔴 本次收斂之前這句對逃生口是假的：三個開關直讀 os.environ ⇒ 在 .env 設也關不掉，
#      而「關掉了」與「沒關掉」外觀完全相同。
#   ② AutoClaude/.env   —— 引擎側讀（autoclaude/utils/config.py:_quota_env）；同名鍵
#      覆寫①。引擎只讀它真的有消費者的那幾個鍵，清單見 AutoClaude/.env.example。
#   ③ .claude/settings.json 的 env 區塊 —— **會**注入 hook 行程（實測：把
#      SDD_ROUTER_QUIET=1 放進去，SessionStart 的 SDD-ROUTER 由 4 行變 0 行）。
# 行內註解（值後面接 ` # …`）會被剝掉 ⇒ 手寫時可以加註解。
# 開始注意、少派（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_NOTICE_PCT=50
# 開始收斂（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CONVERGE_PCT=70
# 準備下一次 Reset（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PREPARE_PCT=85
# 停止並喚醒下一輪（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_HALT_PCT=95
# reset 在這麼近之內 ⇒ 加速（使用者原文的 30m）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_ACCEL_WINDOW_MINUTES=30
# 超過這麼遠 ⇒ 減速（6h）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_FAR_HORIZON_MINUTES=360
# notice 帶的 base cap（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CAP_NOTICE=8
# converge 帶的 base cap（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CAP_CONVERGE=4
# prepare 帶的 base cap（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_CAP_PREPARE=2
# reset 近在眼前時的**加速**倍率（下界 1＝不加速；R84／6b）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_NEAR=2
# reset 很遠／期程不明時的**減速**倍率（上界 1＝不減速；R84／6b）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_FAR=0.5
# 配速上限：PACE_INDEX 超過才判超前（1＝任何超前即減速；PRD §4.2.8）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_PACE_CEILING=1
# 加速後的絕對上界（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_MAX_FANOUT=16
# 量不到時的上限（絕不是「不設限」；≤ cap_prepare）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_DEGRADED_CAP=2
# 節流帶 cap 的**上限**覆寫（留空＝不覆寫）：只收緊不放寬，halt 帶不吃（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_FANOUT_CAP=
# 離開 unmeasured 前需連續幾次量得到（PRD §4.2.4(a)：≥2）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_AVAILABILITY_EXIT_STREAK=2
# 離開 unmeasured 前至少停留幾秒（不變式：QUOTA_CACHE_TTL_SECONDS ≤ 本值 ≤ SENTINEL_INTERVAL_SECONDS，PRD R15／R16；兩個常數的現查見那兩支檔）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_AVAILABILITY_MIN_DWELL_SECONDS=360
# 併發上限「增加」方向的最小停留時間（PRD §4.2.4(d)；「減少」方向不受此限）（範例值，可依帳號方案調整）
AUTOSDD_QUOTA_MIN_DWELL_SECONDS=300
# 喚醒選路：逐字稿超此位元組數即降級 FRESH（留空＝內建 32MiB）（範例值，可依帳號方案調整）
AUTOSDD_RESUME_MAX_TRANSCRIPT_BYTES=
# 接力：每個 reset 視窗最多自動續跑幾次（出廠 2）（範例值，可依帳號方案調整）
AUTOSDD_RELAY_MAX_SPAWNS=2
# 接力：連續幾窗零新進度即停止（出廠 1＝零推進即停，對齊 R112 語意）（範例值，可依帳號方案調整）
AUTOSDD_RELAY_NO_PROGRESS_LIMIT=1

# ── 既有逃生口（此前只散落在 hook 註解裡，零使用者可讀清單）──
# 1 ⇒ 額度節流全關
AUTOSDD_QUOTA_GUARD_OFF=
# 1 ⇒ 額度續航哨兵關掉
AUTOSDD_SENTINEL_OFF=
# 1 ⇒ context 阻斷關掉（**與上一個不同的東西**）
AUTOSDD_CONTEXT_GUARD_OFF=
# 1 ⇒ 只關送達面
AUTOSDD_CONTEXT_SIGNAL_OFF=
# 1 ⇒ 醒來只探測＋留痕，不自動續跑（session_resume_planner.py 專屬）
AUTOSDD_RESUME_OFF=
