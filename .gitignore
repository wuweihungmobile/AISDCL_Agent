# AISDCL_Agent monorepo 根層 .gitignore（快照式單一 repo；子專案各自的 .gitignore 仍生效）

# 巢狀 git repo 備份目錄（push 期間暫時改名的本地 .git，絕不入庫）
.git-nested-backup/
**/.git-nested-backup/

# Python 通用快取
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 虛擬環境
.venv/
venv/
# dev_start 平台 venv 快取（跨平台共用工作目錄時保留另一平台 venv，秒級換手）
/.venv-cache-*/

# dev_start 環境偵測狀態檔（Developing 平台紀錄；共用工作目錄時隨磁碟跨機、
# 雙 clone 時各機獨立，皆不入庫）
/.dev_env_state.json

# 環境設定（API Key 絕不 commit）
.env
.env.*
!.env.example

# Claude Code 本機個人設定（permission 條目含機器本地路徑，留在本機不入庫；
# 各機器初次 pull 後從同目錄 settings.local.json.example 複製還原）
**/.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 大型模型快取（GB 級，GitHub 限制）
.model_cache/

# improving_21 closure 證據 hook runtime 取證輸出（DEF-21-002；closure_evidence_verify
# 以 git toplevel＝monorepo 根為 repo_root，write_verdict_report/write_rederive_cert
# 在根 build/reports/closure/ 產生 VERDICT-<sha>.yaml / REDERIVE-<sha>.yaml，屬「輸出非輸入」
# runtime 產物，同 AISDLC_SDD 各版 build/reports 排除精神）
/build/reports/closure/
# post_commit_drift.py 同以 git toplevel＝monorepo 根為 repo_root，write 到根
# build/reports/drift/ 產生 COMMIT-<sha>.yaml（同 closure 之「輸出非輸入」runtime 產物）
/build/reports/drift/

# AutoClaude 測試/執行於 monorepo 根 cwd 落地的 runtime 產物（escalation dumps、
# checkpoint、kb metrics/goal_progress jsonl、perf 結果等「輸出非輸入」可重生衍生物，
# 同 build/reports 排除精神；以 / 前綴鎖根層，不誤傷子專案內同名目錄）
/checkpoints/
/logs/
/perf_results.json
