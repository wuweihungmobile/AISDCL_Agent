# AISDCL_Agent monorepo 根層 .gitignore（快照式單一 repo；子專案各自的 .gitignore 仍生效）

# 巢狀 git repo 備份目錄（push 期間暫時改名的本地 .git，絕不入庫）
.git-nested-backup/
**/.git-nested-backup/

# Python 通用快取
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 虛擬環境
.venv/
venv/
# dev_start 平台 venv 快取（跨平台共用工作目錄時保留另一平台 venv，秒級換手）
# 不留尾隨斜線：尾隨 / 只匹配目錄，但 _ensure_venv_shape() 明文處理該路徑本身是
# symlink 的拓樸（換手來源/目標皆可能是 symlink）——拿掉尾隨斜線同時涵蓋目錄與 symlink
/.venv-cache-*

# dev_start 環境偵測狀態檔（Developing 平台紀錄；共用工作目錄時隨磁碟跨機、
# 雙 clone 時各機獨立，皆不入庫）
/.dev_env_state.json
# step_finalize() 原子寫入（temp+replace）用的暫存檔；正常完成會自動清掉，
# 只有寫入中途被中斷才會殘留
/.dev_env_state.json.tmp-*

# dev_start venv bootstrap 互斥鎖（防止併發/中斷重跑競態寫入 .venv；正常完成
# 會自動釋放清除，非預期殘留代表上次執行未正常結束，見 _acquire_bootstrap_lock）
/.dev_start.lock

# 環境設定（API Key 絕不 commit）
.env
.env.*
!.env.example

# Claude Code 本機個人設定（permission 條目含機器本地路徑，留在本機不入庫；
# 各機器初次 pull 後從同目錄 settings.local.json.example 複製還原）
**/.claude/settings.local.json

# Claude Code Agent 工具 isolation:"worktree" 建立的隔離副本（每個是全 repo 的臨時
# git worktree checkout，agent 沒清乾淨時會殘留數千個檔案，讓 VSCode Source Control
# 誤判為大量未提交變更；本身即受 git worktree 機制管理，不應被主 repo 追蹤）
.claude/worktrees/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 大型模型快取（GB 級，GitHub 限制）
.model_cache/

# improving_21 closure 證據 hook runtime 取證輸出（DEF-21-002；closure_evidence_verify
# 以 git toplevel＝monorepo 根為 repo_root，write_verdict_report/write_rederive_cert
# 在根 build/reports/closure/ 產生 VERDICT-<sha>.yaml / REDERIVE-<sha>.yaml，屬「輸出非輸入」
# runtime 產物，同 AISDLC_SDD 各版 build/reports 排除精神）
/build/reports/closure/
# post_commit_drift.py 同以 git toplevel＝monorepo 根為 repo_root，write 到根
# build/reports/drift/ 產生 COMMIT-<sha>.yaml（同 closure 之「輸出非輸入」runtime 產物）
/build/reports/drift/

# AutoClaude 測試/執行於 monorepo 根 cwd 落地的 runtime 產物（escalation dumps、
# checkpoint、kb metrics/goal_progress jsonl、perf 結果等「輸出非輸入」可重生衍生物，
# 同 build/reports 排除精神；以 / 前綴鎖根層，不誤傷子專案內同名目錄）
/checkpoints/
/logs/
/perf_results.json

# R57 ARCH-R57R3-03：run_root_unittests 失敗明細落檔（診斷用，不入庫）
# DEF-200-162：檔名改帶時間戳／HEAD 短碼並輪替最近 N 份，pattern 需跟著改
tools/.last_failure_*.log
# 🔴 舊固定檔名同時保留：DEF-200-162 換 pattern 時把它一起拿掉了，而既有 checkout
# 上那支殘檔（改版前寫的）並不會自己消失 ⇒ Source Control 永久多一支未追蹤雜訊。
# `*` 不匹配空字串，故上一行涵蓋不到它。今日已無程式碼寫這個名字，此行純為殘檔除噪。
tools/.last_failure.log

# act 實跑帳本（run_act_core.py `--verify-all` 寫入，`--list` 讀取）。
# 刻意**不入庫**：它記的是「**這台機器**上那一次 act 執行真的走完了」——是本機量測值，
# 不是 repo 的性質。入庫等於把 A 機器的實跑結果變成 B 機器的 ✅，而那正是本 repo 反覆在
# 治的「宣稱先於查證」。每台機器自己跑、自己記帳。
/.act-runs/
