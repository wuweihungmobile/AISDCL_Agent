# AutoClaude .env 範本
# ---------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env
#   填入真實憑證後存檔
#   .env 已被 .gitignore 排除，絕對不會 commit 至 GitHub
#
# ⚠️ 重要：AutoClaude 不會自動載入本 .env（專案未裝 python-dotenv、程式無 load_dotenv，
#    只直接讀 os.environ）。故本檔的變數須由「啟動方式」自行注入環境才會生效，例如：
#      - bash：  set -a; source .env; set +a; python -m autoclaude <playbook.yaml>
#      - 或於啟動前手動 export 各變數 / 由你的 launcher 載入
#    若不便載入 env，亦可改把對應值直接填入 config.yaml（或 config.local.yaml）的對應欄位。
# ---------------------------------------------------------------------------

# === Minimax 區域選擇（重要！）==============================================
# Minimax 有 3 套 endpoint，**API key 來源平台必須與 endpoint 區域對齊**：
#   🌐 國際版（International）：API key 來自 https://platform.minimax.io
#       → endpoint = https://api.minimax.io/v1/...
#   🇨🇳 中國版（Mainland）：     API key 來自 https://platform.minimaxi.com
#       → endpoint = https://api.minimaxi.com/v1/...
#   ⚠️ 舊版 api.minimax.chat：   逐步淘汰中，建議遷移
#
# 區域不匹配 → 回傳 base_resp.status_code=2049 "invalid api key"

# === Minimax LLM API（chat/correction）======================================
# 🔴 設定治理（improving_90 統一）：base_url / model 的「權威預設」在 config.yaml minimax.* 區塊
#    （非機密、入庫共享）；本檔 .env 只負責【機密】MINIMAX_API_KEY 與【選配臨時覆寫】。
#    讀取優先序 env > config.yaml（main.py:103-107），故下方 BASE_URL/MODEL 平常【不需設定】，
#    僅在臨時覆寫（如切 mock/local LLM，見下節）時才取消註解；避免與 config.yaml 重複漂移。
MINIMAX_API_KEY=your_minimax_api_key_here
# 選配覆寫（平常留註解；預設值見 config.yaml minimax.base_url / minimax.model）：
# MINIMAX_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2
# MINIMAX_MODEL=MiniMax-M2.7

# === 本地 Brain 端點（高擬真 API/LLM 模擬；避免測試連外部 API）================
# 回應契約為 OpenAI-compatible（choices[0].message.content），故下列端點皆可直接接線。
# 啟動方式見 docs/08_deployment/Local_CI_Parity_Guide.md §4 + docker-compose.llm.yml。
#   Mock（確定性替身，零下載）：
#     docker compose -f docker-compose.llm.yml --profile mock up -d
#     MINIMAX_BASE_URL=http://localhost:9100/v1/chat/completions
#     MINIMAX_API_KEY=mock
#   vLLM（真模型 Qwen，需 GPU）：
#     docker compose -f docker-compose.llm.yml --profile llm up -d
#     MINIMAX_BASE_URL=http://localhost:8000/v1/chat/completions
#     MINIMAX_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# === Minimax Embedding API（SD_06 W3，雙 adapter 之一）=======================
# 🔴 設定治理（improving_91 方案 B）：base_url / model / dimension 為【非機密預設】，已收進
#    config.yaml 的 embedder: 區塊（入庫共享、權威源）。以下 env 僅作【臨時覆寫】（如切區域 /
#    換 model），平常可留註解、自動吃 config.yaml 兜底。讀取優先序：建構參數 > env > config.yaml > 硬編。
#    （DEF-91-002 修復：MINIMAX_EMBED_MODEL 先前 adapter 從未讀取，improving_91 起真正生效。）
# ⚠️ endpoint 必須與 API key 來源區域一致（同上方 LLM 區域選擇規則）：
#   國際版 key（sk-... from platform.minimax.io）  → api.minimax.io/v1/embeddings
#   中國版 key（sk-cp... from platform.minimaxi.com）→ api.minimaxi.com/v1/embeddings
# MINIMAX_EMBED_BASE_URL=https://api.minimax.io/v1/embeddings   # 覆寫用；預設見 config.yaml
# MINIMAX_EMBED_MODEL=embo-01                                   # 覆寫用；預設見 config.yaml
# MINIMAX_EMBED_DIMENSIONS=1024                                 # 覆寫用；預設見 config.yaml
# 🔑【機密】embedder 與 chat 共用上方 MINIMAX_API_KEY（絕不入庫 config.yaml）。
# ⚠️ 必填：Minimax 帳號 Group ID（從 platform.minimax.io 帳號頁取得，個人帳號通常等於 UID）
# embedding API 必須以 ?GroupId=... query param 傳遞，否則回傳 base_resp 錯誤。
# 🔑 group_id 為帳號識別，刻意【不】收進 config.yaml，維持只走本 env（避免帳號識別碼入庫）。
MINIMAX_GROUP_ID=your_minimax_group_id_here

# === BGE-M3 本地 TEI 服務（docker-compose embedder 服務）=====================
# 🔴 設定治理（improving_92 方案 B 收尾）：TEI_URL / TEI_MODEL_ID / TEI_EMBED_DIMENSIONS 為
#    【非機密預設】，已收進 config.yaml 的 embedder.bge_m3_* 區塊（入庫共享、權威源）。以下 env
#    僅作【臨時覆寫】（如改 TEI 容器位址 / 換 model），平常可留註解、自動吃 config.yaml 兜底。
#    讀取優先序：建構參數 > env > config.yaml > 硬編（bgem3_local.py）。TEI 為本地容器、全非機密。
#    （DEF-92-001/002 修復：TEI_MODEL_ID / TEI_EMBED_DIMENSIONS 先前 adapter 從未讀取，
#    improving_92 起真正生效。）
# TEI_URL=http://localhost:8080              # 覆寫用；預設見 config.yaml embedder.bge_m3_url
# TEI_MODEL_ID=BAAI/bge-m3                   # 覆寫用；預設見 config.yaml embedder.bge_m3_model
# TEI_EMBED_DIMENSIONS=1024                  # 覆寫用；預設見 config.yaml embedder.bge_m3_dimension（BGE-M3 固定維度）

# === PostgreSQL（既有，pgvector image）======================================
POSTGRES_USER=autoclaude
POSTGRES_PASSWORD=autoclaude
POSTGRES_DB=autoclaude
POSTGRES_PORT=5432

# AutoClaude 透過此 DSN 連線（與 docker-compose 服務名稱對齊）
AUTOCLAUDE_DB_DSN=postgresql+asyncpg://autoclaude:autoclaude@localhost:5432/autoclaude?sslmode=disable
# 本機 dev 跳過 TLS；production 必移除
AUTOCLAUDE_ALLOW_INSECURE_DB=1

# 註（improving_92 設定治理清理）：storage.mode 為非機密設定，程式實際只讀 config.yaml
#   （storage: 區塊），不讀 env——原 AUTOCLAUDE_STORAGE_MODE 為從未被讀取的幽靈鍵，已移除。

# === 桌面通知開關（R82 ACC-01）=============================================
# 🔴 出廠預設已改為【不彈】（config.yaml notification.enabled: false）。
#    原因：彈窗是 POST_RUN 才發的，會在「跑完之後」冒出來，並讓行程被 plyer 的
#    非 daemon 執行緒多吊住 notification.duration_seconds 秒。
# 本鍵是雙向開關，**真的有被讀取**（autoclaude/utils/config.py::NotificationConfig
# .apply_env_switch，優先序 env > config.yaml），不是幽靈鍵：
#   1/true/yes/on  → 強制開啟彈窗（臨時想看一次，不必改入庫的 config.yaml）
#   0/false/no/off → 強制關閉（無人看管跑批 / CI 用）
#   未設定         → 依 config.yaml 的 notification.enabled
# ⚠️ 關掉的只有「彈窗」；ESCALATION 仍永遠寫 checkpoints/escalation_alert.log（刻意保留）。
# AUTOCLAUDE_DESKTOP_NOTIFY=0

# === 帳號額度水位門檻（R82；掌舵者訴求 b/c）=================================
# 🔴 這一區的「唯一的家」**不在本檔**，是 monorepo 根層 tools/lib/quota_policy.py 的
#    ENV_SPEC（四個錨點 50/70/85/95 ＋ 期程分界 ＋ 各帶 cap）。本檔只鏡射「AutoClaude
#    真的有讀者」的那幾個鍵——把整份階梯抄過來就是 13 個幽靈鍵，而本檔自己就記載過
#    improving_92 清掉過一批同型（見上方 storage.mode / SD08 兩段註）。
#    完整清單（含 cap 與期程分界，扇出型工具那一側才吃）：
#      python tools/lib/quota_policy.py --print-env-example
#
# 🔴 兩份 .env 的關係＝**繼承 ＋ 覆寫**（判準：tests/test_r82_quota_axis_and_shipped_defaults
#    .py::TestQuotaThresholdsComeFromTheSharedDeclaration）：
#      os.environ  >  AutoClaude/.env  >  <repo 根>/.env  >  出廠預設
#    · 根 .env 是兩側共用的基底（harness 的 hook 也讀它）⇒ 只寫一次，兩邊一致；
#    · 本目錄的 .env 只在「引擎要與 harness 不同」時才寫，它贏。
#    ⚠️ 本區這兩個鍵**會自己就地讀檔**（autoclaude/utils/config.py::_quota_env），
#       不受本檔第 8 行「AutoClaude 不自動載入 .env」的限制——那句話對其餘鍵仍然成立。
#
# 分母是**帳號方案**（伺服器算好的 %），不是 context window：與 token_guard 的
# compact/halt 兩道門絕對不共用。數值是**範例**，可依帳號方案調整；🔴 但 95 那條是
# 安全線，只准往下調、不得放寬。
#
# 開始收斂：達此水位即停掉「可選支出」（CORRECTION 重試——每一次重試都是再打一次
# claude，反而加速燒額度）；正常步驟仍放行。＝根層階梯的 converge。
AUTOSDD_QUOTA_CONVERGE_PCT=70
# 停止並準備下一次 Reset：整場 halt，改由 AutoResumeService 依觀測到的 resets_at 等待。
AUTOSDD_QUOTA_HALT_PCT=95
# 誠實缺口（不放進本檔，因為今天**沒有讀者**，放了就是幽靈鍵）：
#   AUTOSDD_QUOTA_NOTICE_PCT(50，少派 agent)／AUTOSDD_QUOTA_CAP_*／MAX_FANOUT
#     —— 扇出節流是 harness hook 那一側的事，引擎不派 agent。
#   AUTOSDD_QUOTA_PREPARE_PCT(85，提前準備下一次 reset)
#     —— 引擎今天只在 halt 才動作，沒有「85% 就開始準備」的行為可接。要接的是
#        AutoResumeService，不是多一個常數；未接線之前不印在這裡。

# === SD_Improving_06 W0（PM 拍板 #8 / #11）==================================
# PM #8：goal_task 同時最大並存 run 數；Coordinator W2 落地前 guard
# 超過則新 run 進 enqueue 佇列（執行指南 W2-T2-15 / W2-T2-16）
MAX_ACTIVE_RUNS_PER_GOAL=5

# PM #11：PII hybrid 策略總開關
# W3 起所有寫入 drift_log / config_audit_log / yaml_import_diffs 之前
# 強制套用 PII 過濾器（依 autoclaude/models/pii_classification.py ENUM 分類）
# 開發環境可暫時關閉以加速除錯；production 必為 true
PII_FILTER_ENABLED=true

# === SD_Improving_07 W0（ADR-SD07-001 / PM #2 拍板）=========================
# ADR-SD07-001 LOC 政策版本（v1=250 一刀切；v2=分級制 + 絕對紅線 750）
# 工具 tools/check_loc_budget.py 對齊此版本；contract test 依此驗證
LOC_BUDGET_POLICY_VERSION=v2

# PM #2 真實 PG e2e 啟用旗標（W2 起用；CI matrix 加 PG service + opt-in marker）
# false → tests/integration/test_pgvector_real_recall.py 等 skip
# true  → 完整 e2e（recall@10 ≥ 0.95 / p95 < 50ms）；本地開發需先啟動 docker-compose
SD07_REAL_PG_E2E_ENABLED=true

# 註（improving_92 設定治理清理）：以下 SD08/SD09 PG-production / 可觀測性 ops 開關曾在此宣告，
#   但程式至今【從未讀取】（pg_health.py WAL lag 用寫死模組常數 WAL_LAG_WARN_SECONDS=2.0 /
#   CRITICAL=10.0；OBSERVABILITY_BACKEND / PG_PRODUCTION_CUTOVER_GUARD /
#   AUTOCLAUDE_TRACE_ID_SUBPROCESS_PROPAGATION 皆未接線，功能延 SD_09/SD_10）——屬幽靈鍵，
#   已移除避免誤導 operator。待實際在程式接線（真的 os.environ.get）時，再連同讀取點一併加回。
#   設計脈絡仍見 docs/ 之 SD08/SD09 runbook 與 ADR-SD08-005 / ADR-SD09-001/004。
