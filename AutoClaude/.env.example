# AutoClaude .env 範本
# ---------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env
#   填入真實憑證後存檔
#   .env 已被 .gitignore 排除，絕對不會 commit 至 GitHub
# ---------------------------------------------------------------------------

# === Minimax 區域選擇（重要！）==============================================
# Minimax 有 3 套 endpoint，**API key 來源平台必須與 endpoint 區域對齊**：
#   🌐 國際版（International）：API key 來自 https://platform.minimax.io
#       → endpoint = https://api.minimax.io/v1/...
#   🇨🇳 中國版（Mainland）：     API key 來自 https://platform.minimaxi.com
#       → endpoint = https://api.minimaxi.com/v1/...
#   ⚠️ 舊版 api.minimax.chat：   逐步淘汰中，建議遷移
#
# 區域不匹配 → 回傳 base_resp.status_code=2049 "invalid api key"

# === Minimax LLM API（既有，用於 correction）=================================
# MINIMAX_BASE_URL / MINIMAX_MODEL 為 env 覆蓋（main.py 讀取，覆寫 config.yaml minimax.*）。
MINIMAX_API_KEY=your_minimax_api_key_here
# 國際版（推薦，與 platform.minimax.io 對齊）
MINIMAX_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-Text-01

# === 本地 Brain 端點（高擬真 API/LLM 模擬；避免測試連外部 API）================
# 回應契約為 OpenAI-compatible（choices[0].message.content），故下列端點皆可直接接線。
# 啟動方式見 docs/08_deployment/Local_CI_Parity_Guide.md §4 + docker-compose.llm.yml。
#   Mock（確定性替身，零下載）：
#     docker compose -f docker-compose.llm.yml --profile mock up -d
#     MINIMAX_BASE_URL=http://localhost:9100/v1/chat/completions
#     MINIMAX_API_KEY=mock
#   vLLM（真模型 Qwen，需 GPU）：
#     docker compose -f docker-compose.llm.yml --profile llm up -d
#     MINIMAX_BASE_URL=http://localhost:8000/v1/chat/completions
#     MINIMAX_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# === Minimax Embedding API（SD_06 W3，雙 adapter 之一）=======================
# ⚠️ endpoint 必須與 API key 來源區域一致（同上方 LLM 區域選擇規則）：
#   國際版 key（sk-... from platform.minimax.io）  → api.minimax.io/v1/embeddings
#   中國版 key（sk-cp... from platform.minimaxi.com）→ api.minimaxi.com/v1/embeddings
MINIMAX_EMBED_BASE_URL=https://api.minimax.io/v1/embeddings
MINIMAX_EMBED_MODEL=embo-01
# ⚠️ 必填：Minimax 帳號 Group ID（從 platform.minimax.io 帳號頁取得，個人帳號通常等於 UID）
# embedding API 必須以 ?GroupId=... query param 傳遞，否則回傳 base_resp 錯誤
MINIMAX_GROUP_ID=your_minimax_group_id_here
# embo-01 維度（待 tools/probe_minimax_embedding.py 實測後填入）
MINIMAX_EMBED_DIMENSIONS=

# === Embedding Backend 切換（SD_06 W3 IEmbedder port）=======================
# 可選值：bge_m3_local | minimax_api
# bge_m3_local → 走本地 TEI 容器（推薦，零費用、< 50ms）
# minimax_api  → 走 Minimax embo-01 API（備援，網路依賴）
EMBEDDER_BACKEND=bge_m3_local

# === BGE-M3 本地 TEI 服務（docker-compose embedder 服務）=====================
# AutoClaude 對 TEI 容器的 HTTP 端點
TEI_URL=http://localhost:8080
TEI_MODEL_ID=BAAI/bge-m3
# BGE-M3 固定維度
TEI_EMBED_DIMENSIONS=1024

# === PostgreSQL（既有，pgvector image）======================================
POSTGRES_USER=autoclaude
POSTGRES_PASSWORD=autoclaude
POSTGRES_DB=autoclaude
POSTGRES_PORT=5432

# AutoClaude 透過此 DSN 連線（與 docker-compose 服務名稱對齊）
AUTOCLAUDE_DB_DSN=postgresql+asyncpg://autoclaude:autoclaude@localhost:5432/autoclaude?sslmode=disable
# 本機 dev 跳過 TLS；production 必移除
AUTOCLAUDE_ALLOW_INSECURE_DB=1

# === Storage Mode（SD_Improving_02 §2.8）====================================
# yaml_only | both | db_only
AUTOCLAUDE_STORAGE_MODE=yaml_only

# === Notification（既有）====================================================
NOTIFICATION_ENABLED=true

# === SD_Improving_06 W0（PM 拍板 #8 / #11）==================================
# PM #8：goal_task 同時最大並存 run 數；Coordinator W2 落地前 guard
# 超過則新 run 進 enqueue 佇列（執行指南 W2-T2-15 / W2-T2-16）
MAX_ACTIVE_RUNS_PER_GOAL=5

# PM #11：PII hybrid 策略總開關
# W3 起所有寫入 drift_log / config_audit_log / yaml_import_diffs 之前
# 強制套用 PII 過濾器（依 autoclaude/models/pii_classification.py ENUM 分類）
# 開發環境可暫時關閉以加速除錯；production 必為 true
PII_FILTER_ENABLED=true

# === SD_Improving_07 W0（ADR-SD07-001 / PM #2 拍板）=========================
# ADR-SD07-001 LOC 政策版本（v1=250 一刀切；v2=分級制 + 絕對紅線 750）
# 工具 tools/check_loc_budget.py 對齊此版本；contract test 依此驗證
LOC_BUDGET_POLICY_VERSION=v2

# PM #2 真實 PG e2e 啟用旗標（W2 起用；CI matrix 加 PG service + opt-in marker）
# false → tests/integration/test_pgvector_real_recall.py 等 skip
# true  → 完整 e2e（recall@10 ≥ 0.95 / p95 < 50ms）；本地開發需先啟動 docker-compose
SD07_REAL_PG_E2E_ENABLED=true

# === SD_Improving_08 W4（ADR-SD08-004 IObservabilityPort + 階段性混合）====
# 可觀測性後端切換（W4 落地）
# 可選值：local_logger（W4 預設，零依賴）/ otel（SD_10 OpenTelemetry 接管）
OBSERVABILITY_BACKEND=local_logger

# === SD_Improving_08 W5（ADR-SD08-005 PG 雙軌制 + WAL lag 三閾值）=========
# pg_health.py 監控 WAL replication lag 告警閾值（單位：秒）
# < WARN：正常 / WARN~CRITICAL：warning emit / > CRITICAL：critical emit + 阻擋切換
PG_WAL_LAG_WARN_SECONDS=2.0
PG_WAL_LAG_CRITICAL_SECONDS=10.0

# === SD_Improving_09 W0（PM 拍板 #4 / #7 / cutover guard）===================
# PM #7 (a)：PG db_only 切換 cutover guard（W5 雙條件齊備前嚴禁切換 db_only）
# true → cutover script 啟用守門檢查（observability_ga_check.py + drift_log 30d zero）
# false → ⚠️ 僅限 SD_10 G5 雙條件達標後手動關閉；違反 ADR-SD09-001 §2.2
PG_PRODUCTION_CUTOVER_GUARD=true

# PM #4 (b)：trace_id subprocess 傳播路徑（W3C TraceContext）
# 可選值：env_var（路徑 a；已棄）/ w3c_traceparent（路徑 b；本 Sprint 選定）/ disabled（路徑 c；延 SD_10）
# 落地點：autoclaude/utils/trace_context.py propagate_to_subprocess_env() helper
# 9 處 subprocess 注入點統一呼叫（詳見 ADR-SD09-004 §2.3）
AUTOCLAUDE_TRACE_ID_SUBPROCESS_PROPAGATION=w3c_traceparent
