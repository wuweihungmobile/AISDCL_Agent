#!/usr/bin/env bash
# AutoClaude git pre-push hook — push 前完整 CI 閘門鏡像（在本機把所有問題解決完才上版）
# 鏡像 .github/workflows/autoclaude-ci.yml 的 push gating jobs：
#   test（pytest + LOC + import-linter）/ claude-md-budget（CLAUDE.md + snapshot）/ equivalence
# 安裝：tools/install_git_hooks.sh / .ps1（設 core.hooksPath=<repo根>/tools/git-hooks 根層 dispatcher，依路徑分流至本檔）
# 緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git push ...  或  git push --no-verify
# 注意：本 hook 在 macOS / Windows 皆跑本機 Python；如需 100% Linux 對等，
#       macOS/Linux 另跑 bash tools/run_act.sh --job test、Windows 另跑 tools/run_act.ps1。
# ---------------------------------------------------------------------------
set -uo pipefail

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-push] AUTOCLAUDE_SKIP_HOOKS=1 → 跳過所有檢查"
  exit 0
fi

# 定位子專案根：git 執行 hooks 時 cwd＝該工作樹頂層，故以 --show-toplevel + /AutoClaude
# 為第一優先（linked worktree 內 push 時才會檢查「該 worktree 的樹」，而非安裝時的主
# checkout）；取不到才 fallback BASH_SOURCE 自我定位（並印警告）。
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "${TOPLEVEL:-}" ]; then
  ROOT="$TOPLEVEL/AutoClaude"
else
  echo "[pre-push] ⚠ git rev-parse --show-toplevel 失敗 → fallback BASH_SOURCE 自我定位（linked worktree 下可能指向主 checkout）" >&2
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
cd "$ROOT" || exit 1
# linked worktree：git 對 hook 匯出 GIT_DIR 但不匯出 GIT_WORK_TREE，cd 進子目錄後 git 會
# 誤把 cwd 當工作樹頂層（相對路徑邏輯失效）；顯式錨定工作樹根。
if [ -n "${GIT_DIR:-}" ] && [ -n "${TOPLEVEL:-}" ]; then
  export GIT_WORK_TREE="$TOPLEVEL"
fi

# WindowsApps 空殼 python 排除 guard（R46：本檔先前完全裸呼叫 python，未 source
# 任何 SSOT，全新未裝真 Python 的 Windows 11 機器上會直接撞見 Store 空殼卡住
# push；比照 tools/git-hooks/pre-push 根層 dispatcher 同款用法）。
# shellcheck disable=SC1091
. "$ROOT/../tools/lib/windowsapps_guard.sh"
# 🔴 DEF-200-294：單一 .venv 設計——根層優先＋健康探針（取代原「優先探測本專案
# 自己的 venv」WHY）。`tools/bootstrap_core.py` 只建 monorepo 根層一個 `.venv`，
# AutoClaude 以 editable（`.[dev,notifications,lint]`）裝進同一個根層 venv；
# `AutoClaude/tools/bootstrap.*` 已不存在，凡存在的 `AutoClaude/.venv` 都是
# 歷史遺留（舊 bootstrap／手動建立／IDE 自建）。2026-09-13 一個陳舊
# `AutoClaude/.venv`（Python 3.12.11、無 pytest-xdist）被舊版「子專案優先」
# 候選鏈第一順位撿到 ⇒ `pyproject.toml` 全域 addopts `-n auto` 讓 pytest rc=4
# `unrecognized arguments`，表徵與「程式碼壞了」無法區分；刪掉該 venv 才轉綠。
# 修法：根層 `.venv` 優先＋每個候選皆過健康探針（能否 import pytest/xdist）
# 才算數，陳舊子專案 venv 只出聲提醒、不再被優先選中。
# DEF-200-297：子專案 venv fallback 已徹底移除（不只是降權）——2026-09-13
# 事故的本質是「撿到了但撿錯」而非「沒撿到」，fail-loud（直接報錯給修法指令）
# 優於繼續留一條可能撿到錯直譯器的退路。

# 健康探針：`AutoClaude/pyproject.toml` 全域 addopts `-n auto` 使 xdist 是本
# hook 第 5 步 pytest 的硬前提；沒有它 pytest rc=4 的訊息與程式碼壞掉無法區分
# （2026-09-13 實例）。候選存在但探針失敗 → 出聲＋跳過，不當場判死，繼續下一個。
_py_health() {
  "$1" -c 'import pytest, xdist' >/dev/null 2>&1
}

# 根層 monorepo 頂層：第 20～26 行 fallback 分支下 TOPLEVEL 可能為空，此處補上
# 同義 fallback（該分支下 $ROOT 已自我定位為 AutoClaude 絕對路徑，$ROOT/.. 即
# monorepo 根，語意等價於有 TOPLEVEL 時的 "$TOPLEVEL"）。
_MONO="${TOPLEVEL:-$ROOT/..}"

PY=""

# ① 根層 .venv（單一 .venv 設計下的唯一建議位置）。
for _py_cand in "$_MONO/.venv/bin/python" "$_MONO/.venv/Scripts/python.exe"; do
  if [ -x "$_py_cand" ]; then
    if _py_health "$_py_cand"; then
      PY="$_py_cand"
      break
    fi
    echo "[pre-push] ⚠️  ${_py_cand} 缺 pytest／pytest-xdist（陳舊 venv 或未裝相依）→ 跳過此候選" >&2
  elif [ -e "$_py_cand" ]; then
    # 🔴 保留既有語意（第四輪對抗式複審 SA/SD minor finding；四方審查第二棒
    # Architect minor：仿②迴圈補上此分支使兩處對稱）：候選存在但不可執行
    # （權限異常之類）時先出聲再退回下一候選，符合 Rule 12 Fail loud。
    echo "[pre-push] ⚠️  ${_py_cand} 存在但不可執行（權限異常？）— 退回下一候選" >&2
  fi
done

# ② 子專案 .venv（歷史遺留）：只要存在就出聲一次，**不進候選鏈**（DEF-200-297：
# 子專案 venv 永不被選中，只提醒＋給可直接複製的刪除指令）——bootstrap 只建
# 根層 .venv，本目錄（$ROOT）下的 .venv 只可能是舊 bootstrap／手動建立／IDE
# 自建的殘留物，依單一 .venv 設計（根 ONBOARDING §2.1／DEF-200-294）應刪除。
if [ -x "$ROOT/.venv/bin/python" ] || [ -x "$ROOT/.venv/Scripts/python.exe" ] \
   || [ -e "$ROOT/.venv/bin/python" ] || [ -e "$ROOT/.venv/Scripts/python.exe" ]; then
  echo "[pre-push] ⚠️  偵測到子專案 venv（$ROOT/.venv）— 單一 .venv 設計下屬歷史遺留，建議刪除：" >&2
  echo "[pre-push]      Remove-Item -Recurse -Force \"$ROOT/.venv\"   （PowerShell）" >&2
  echo "[pre-push]      rm -rf \"$ROOT/.venv\"                        （bash）" >&2
fi

# ③ PATH：python → python3（維持 is_real_python_candidate 守門，DEF-101-740 候選鏈）。
# 🔴 DEF-200-315（2026-09-19）：本機根層 .venv 缺席不再退回 PATH——單一 .venv 設計
# （ONBOARDING §2.1）下互動式入口只認根層 .venv；PATH fallback 只在 CI／容器
# （repo_python_path_fallback_allowed：GITHUB_ACTIONS／CI／逃生口 AUTOSDD_ALLOW_PATH_PYTHON=1）
# 容許，本機缺席時落到下方既有 ❌ fail-loud 訊息（該訊息已含修法）。
if [ -z "$PY" ] && repo_python_path_fallback_allowed; then
  if [ -z "$PY" ] && is_real_python_candidate python; then
    if _py_health python; then
      PY=python
    else
      echo "[pre-push] ⚠️  PATH 上的 python 缺 pytest／pytest-xdist → 跳過此候選" >&2
    fi
  fi
  if [ -z "$PY" ] && is_real_python_candidate python3; then
    if _py_health python3; then
      PY=python3
    else
      echo "[pre-push] ⚠️  PATH 上的 python3 缺 pytest／pytest-xdist → 跳過此候選" >&2
    fi
  fi
fi

if [ -z "$PY" ]; then
  echo "[pre-push] ❌ 找不到可用的直譯器（已試：根層 .venv（PATH 僅 CI／AUTOSDD_ALLOW_PATH_PYTHON=1 容許），皆缺席或缺 pytest/xdist）" >&2
  echo "[pre-push]    修法（擇一，逐字可執行）：" >&2
  echo "[pre-push]      source .venv/bin/activate   （Windows: .venv\\Scripts\\Activate.ps1）" >&2
  echo "[pre-push]      uv pip install -e 'AutoClaude/.[dev,notifications,lint]'" >&2
  exit 1
fi

export PYTHONUTF8=1
fail=0

echo "[pre-push] === 本機 CI 閘門（鏡像 autoclaude-ci.yml push jobs）==="

# 1. LOC 預算（CI: test / claude-md-budget）
echo "[pre-push] 1/5 LOC 預算"
"$PY" tools/check_loc_budget.py || fail=1

# 2. CLAUDE.md <= 400 行（CI: claude-md-budget hard gate）
echo "[pre-push] 2/5 CLAUDE.md <= 400 行"
if [ -f CLAUDE.md ]; then
  lines="$(wc -l < CLAUDE.md | tr -d ' ')"
  if [ "$lines" -gt 400 ]; then
    echo "::error:: CLAUDE.md=$lines 行 > 400"
    fail=1
  fi
fi

# 3. Architecture Snapshot 可重現（CI: claude-md-budget 的 snapshot_sync --check）
echo "[pre-push] 3/5 snapshot_sync.py --check"
"$PY" tools/snapshot_sync.py --check || fail=1

# 4. import-linter 架構約束（CI: test 的 lint-imports）
#    未安裝即 fail（與 local_ci_gate.sh gate_importlinter 同語意；R9 複審：原本軟跳過
#    宣稱「CI 仍會檢查」，CI 帳單停擺期間即為 fail-open）
echo "[pre-push] 4/5 import-linter（架構約束）"
if command -v lint-imports >/dev/null 2>&1; then
  lint-imports || fail=1
else
  echo "[pre-push]   ❌ lint-imports 未安裝（uv pip install -e '.[lint]'）— 架構約束閘門無法執行" >&2
  fail=1
fi

# 5. pytest 全測（CI: test + equivalence）。可用 AUTOCLAUDE_PUSH_PYTEST_ARGS 縮限。
#    ⚠ 本步驟刻意「直跑 pytest、不經 tools/local_ci_gate」（R12 QA-2 紀律）：
#    local_ci_gate 收斂為單核心後，gate 名單的機械凍結繫於其單元測試；本步驟是
#    獨立第二訊號——若改為經 local_ci_gate 呼叫，兩訊號合流即單點化，勿改。
#    ⚠ env -u 清洗（P0）：GIT_DIR/GIT_WORK_TREE 絕不可傳染給 pytest——測試套件含
#    「真 git fixture」（tmp repo 內 git init/add/commit），若繼承這兩個絕對路徑 env，
#    git 會改操作「使用者真 repo」：髒工作樹時把 WIP 偷 commit 上真分支、乾淨樹時
#    fixture 炸掉造成閘門假紅。hook 自身的 git diff（第 6 步）不清洗、行為不變。
echo "[pre-push] 5/5 pytest（CI test+equivalence 鏡像）"
# `-rs`（R59 ARCH-R59-NB1）：與 tools/local_ci_gate.py 的 DEFAULT_PYTEST_ARGS 對齊，
# 否則每次 push 跑的這一套仍把 skip 理由丟掉（DEF-101-510 只補了 unittest 面）。
PYTEST_ARGS="${AUTOCLAUDE_PUSH_PYTEST_ARGS:-tests/ -q -rs --tb=short}"
# DEF-200-274 X1：PG DSN 在場時追加 --dist loadgroup，否則 pyproject.toml 的
# addopts（-n auto --dist worksteal）會讓多個 xdist worker 同時觸碰同一顆 PG
# 資料庫造成競態；conftest.py 已有 fail-loud 的 UsageError 兜底，這裡順手接上
# 讓本機 push 前全套在 PG 在場時直接可用。
# DEF-200-295：「要不要加 --dist loadgroup」的判準只有一個家——local_ci_gate 的
# pg_autodetect()（四條剎車）＋ pg_dsn_in_effect()，conftest 的 X1 守門問的就是
# 它們。舊版在此自己看 AUTOCLAUDE_TEST_PG_DSN／AUTOCLAUDE_DB_DSN 環境變數，等於
# 把判準複製了一半：使用者沒 export 但 autodetect 會自動注入時，hook 這裡說
# 「沒 PG」、conftest 那裡說「有 PG」⇒ 2026-09-14 分離行程 push 實測 UsageError。
# 剎車①（使用者已自行 export）之後 pg_dsn_in_effect() 讀 env 仍為真，故舊條件
# 是新條件的子集，零回歸。
_pg_probe="$(env -u GIT_DIR -u GIT_WORK_TREE "$PY" -c 'import sys; sys.path.insert(0, "tools"); import local_ci_gate as g; g.pg_autodetect(); print("PG_IN_EFFECT=" + ("1" if g.pg_dsn_in_effect() else "0"))' 2>/dev/null || true)"
case "$_pg_probe" in
  *PG_IN_EFFECT=1*) _pg_in_effect=1 ;;
  *PG_IN_EFFECT=0*) _pg_in_effect=0 ;;
  # 探針失敗（例如 local_ci_gate 相依缺席）：保守加 loadgroup——對無 PG 的跑法
  # 無害（只是分配策略不同），寧可多加不可漏加（漏加＝X1 必紅）。
  *) _pg_in_effect=1
     echo "[pre-push] ⚠️  PG 剖面探針沒有回答（local_ci_gate 載入失敗？）→ 保守加 --dist loadgroup" >&2 ;;
esac
case "$PYTEST_ARGS" in
  *--dist*|*no:xdist*|*" -n 0"*) ;;   # 使用者已自行決定分配策略，不重複加
  *) [ "$_pg_in_effect" -eq 1 ] && PYTEST_ARGS="${PYTEST_ARGS} --dist loadgroup" ;;
esac
# shellcheck disable=SC2086
env -u GIT_DIR -u GIT_WORK_TREE "$PY" -m pytest $PYTEST_ARGS || fail=1

# 6. ADR-SD09-011：token_guard 源碼變動偵測（on-change mutation 觸發，opt-in 非阻塞）
#    鎖定累積改由「源碼變動」驅動（取代每日 nightly 計時）；本地 opt-in 因 Windows 原生
#    不支援 mutmut（需 WSL/docker），預設僅提示、CI autoclaude-mutation-on-change.yml 為權威累積通道。
echo "[pre-push] (額外) ADR-SD09-011 token_guard 源碼變動偵測"
# 先落地變數再以 herestring 餵 grep -q（不可 git diff | grep -q —— 清單 >64KB 且命中在
# 前段時 grep -q 提早退出令 git 收 SIGPIPE，pipefail 判整條管線非零 → 偵測靜默漏跑）
tg_files="$(git -c core.quotepath=false diff --name-only origin/main...HEAD 2>/dev/null || true)"
if grep -q 'autoclaude/plugins/token_guard/.*\.py' <<<"$tg_files"; then
  if [ "${AUTOCLAUDE_MUTATION_ON_PUSH:-0}" = "1" ] && [ -f tools/run_mutmut_in_docker.sh ]; then
    echo "[pre-push]   token_guard 源碼有變 + opt-in → 跑 mutation（需 WSL/docker）"
    # 外部測試腳本亦清洗 GIT_DIR/GIT_WORK_TREE（同第 5 步理由，防傳染下游測試子行程）
    env -u GIT_DIR -u GIT_WORK_TREE bash tools/run_mutmut_in_docker.sh token_guard || echo "[pre-push]   mutation 非阻塞"
  else
    echo "[pre-push]   ⚠ token_guard 源碼有變 → 由 CI autoclaude-mutation-on-change.yml 累積 unique sha 證據"
    echo "[pre-push]     （本地累積：AUTOCLAUDE_MUTATION_ON_PUSH=1，需 WSL/docker）"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-push] ❌ 本機 CI 閘門失敗 — 請修復後再 push（這正是要在本機攔下的 CI 紅燈）"
  echo "           100% Linux 對等驗證（macOS/Linux）：bash tools/run_act.sh --job test"
  echo "           100% Linux 對等驗證（Windows）  ：powershell -ExecutionPolicy Bypass -File tools/run_act.ps1 -Job test"
  echo "           緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 或 git push --no-verify"
  exit 1
fi
echo "[pre-push] ✅ 本機 CI 閘門全綠 — 可安全 push"
exit 0
