#!/usr/bin/env bash
# AutoClaude git pre-commit hook — 快速本地把關（目標 < 15s，僅針對已暫存檔）
# 安裝：tools/install_git_hooks.sh / .ps1（設 core.hooksPath=<repo根>/tools/git-hooks 根層 dispatcher，依路徑分流至本檔）
# 緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git commit ...  或  git commit --no-verify
# ---------------------------------------------------------------------------
set -uo pipefail

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-commit] AUTOCLAUDE_SKIP_HOOKS=1 → 跳過所有檢查"
  exit 0
fi

# 定位子專案根：git 執行 hooks 時 cwd＝該工作樹頂層，故以 --show-toplevel + /AutoClaude
# 為第一優先（linked worktree 內 commit 時才會檢查「該 worktree 的樹」，而非安裝時的主
# checkout）；取不到才 fallback BASH_SOURCE 自我定位（並印警告）。
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "${TOPLEVEL:-}" ]; then
  ROOT="$TOPLEVEL/AutoClaude"
else
  echo "[pre-commit] ⚠ git rev-parse --show-toplevel 失敗 → fallback BASH_SOURCE 自我定位（linked worktree 下可能指向主 checkout）" >&2
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
cd "$ROOT" || exit 1
# linked worktree：git 對 hook 匯出 GIT_DIR 但不匯出 GIT_WORK_TREE，cd 進子目錄後 git 會
# 誤把 cwd 當工作樹頂層（--relative 不剝前綴 → 檔案檢查失效）；顯式錨定工作樹根。
if [ -n "${GIT_DIR:-}" ] && [ -n "${TOPLEVEL:-}" ]; then
  export GIT_WORK_TREE="$TOPLEVEL"
fi

# WindowsApps 空殼 python 排除 guard（R46：本檔先前完全裸呼叫 python，未 source
# 任何 SSOT，全新未裝真 Python 的 Windows 11 機器上會直接撞見 Store 空殼卡住
# commit；比照 tools/git-hooks/pre-push 根層 dispatcher 同款用法）。
# shellcheck disable=SC1091
. "$ROOT/../tools/lib/windowsapps_guard.sh"
if is_real_python_candidate python; then
  PY=python
elif is_real_python_candidate python3; then
  PY=python3
else
  echo "[pre-commit] ❌ 找不到可用的 python（PATH 上只有 WindowsApps 空殼或完全缺席）— 請先啟用 venv" >&2
  exit 1
fi

export PYTHONUTF8=1
fail=0

# 1. ruff lint（僅已暫存的 .py；while read 收集為陣列，含空白/非 ASCII 檔名安全，
#    bash 3.2 相容不用 mapfile；quotepath=false 使非 ASCII 檔名不被引號包裹）
staged_py=()
while IFS= read -r f; do
  [ -n "$f" ] && staged_py+=("$f")
done < <(git -c core.quotepath=false diff --cached --name-only --relative --diff-filter=ACMR -- '*.py')
if [ "${#staged_py[@]}" -gt 0 ]; then
  echo "[pre-commit] 1/4 ruff lint（已暫存 .py）"
  if command -v ruff >/dev/null 2>&1; then
    ruff check "${staged_py[@]}" || fail=1
  else
    "$PY" -m ruff check "${staged_py[@]}" || fail=1
  fi
fi

# 2. LOC 預算（靜態掃描，快）— 對齊 CI test/claude-md-budget job
echo "[pre-commit] 2/4 LOC 預算（tools/check_loc_budget.py）"
"$PY" tools/check_loc_budget.py || fail=1

# 3. CLAUDE.md <= 400 行（ADR-SD08-001 / CI hard gate）
echo "[pre-commit] 3/4 CLAUDE.md <= 400 行"
if [ -f CLAUDE.md ]; then
  lines="$(wc -l < CLAUDE.md | tr -d ' ')"
  if [ "$lines" -gt 400 ]; then
    echo "::error:: CLAUDE.md=$lines 行 > 400（ADR-SD08-001）"
    fail=1
  fi
fi

# 4. .sh/.bash 必須 LF 行尾（取證紀律 #8；CRLF 會讓 Docker/Linux bash 噴 $'\r'）
#    while read 逐行處理，含空白/非 ASCII 檔名安全（無引號 for 展開會依空白切字）
echo "[pre-commit] 4/4 .sh/.bash LF 行尾檢查"
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if [ -f "$f" ] && grep -q $'\r' "$f"; then
    echo "::error:: $f 含 CR/CRLF — .sh 必須 LF（取證紀律 #8）"
    fail=1
  fi
done < <(git -c core.quotepath=false diff --cached --name-only --relative --diff-filter=ACMR | grep -E '\.(sh|bash)$' || true)

if [ "$fail" -ne 0 ]; then
  echo "[pre-commit] ❌ 失敗 — 請於本機修復後再 commit"
  echo "           （緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 或 git commit --no-verify）"
  exit 1
fi
echo "[pre-commit] ✅ 全部通過"
exit 0
