#!/usr/bin/env bash
# AutoClaude git pre-commit hook — 快速本地把關（目標 < 15s，僅針對已暫存檔）
# 安裝：tools/install_git_hooks.sh / .ps1（設 core.hooksPath=<repo根>/tools/git-hooks 根層 dispatcher，依路徑分流至本檔）
# 緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git commit ...  或  git commit --no-verify
# ---------------------------------------------------------------------------
set -uo pipefail

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-commit] AUTOCLAUDE_SKIP_HOOKS=1 → 跳過所有檢查"
  exit 0
fi

# 定位子專案根：git 執行 hooks 時 cwd＝該工作樹頂層，故以 --show-toplevel + /AutoClaude
# 為第一優先（linked worktree 內 commit 時才會檢查「該 worktree 的樹」，而非安裝時的主
# checkout）；取不到才 fallback BASH_SOURCE 自我定位（並印警告）。
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "${TOPLEVEL:-}" ]; then
  ROOT="$TOPLEVEL/AutoClaude"
else
  echo "[pre-commit] ⚠ git rev-parse --show-toplevel 失敗 → fallback BASH_SOURCE 自我定位（linked worktree 下可能指向主 checkout）" >&2
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
cd "$ROOT" || exit 1
# linked worktree：git 對 hook 匯出 GIT_DIR 但不匯出 GIT_WORK_TREE，cd 進子目錄後 git 會
# 誤把 cwd 當工作樹頂層（--relative 不剝前綴 → 檔案檢查失效）；顯式錨定工作樹根。
if [ -n "${GIT_DIR:-}" ] && [ -n "${TOPLEVEL:-}" ]; then
  export GIT_WORK_TREE="$TOPLEVEL"
fi

# WindowsApps 空殼 python 排除 guard（R46：本檔先前完全裸呼叫 python，未 source
# 任何 SSOT，全新未裝真 Python 的 Windows 11 機器上會直接撞見 Store 空殼卡住
# commit；比照 tools/git-hooks/pre-push 根層 dispatcher 同款用法）。
# shellcheck disable=SC1091
. "$ROOT/../tools/lib/windowsapps_guard.sh"
# 🔴 DEF-200-294：單一 .venv 設計——根層優先＋健康探針（取代原「優先探測本專案
# 自己的 venv」WHY，見姊妹 hook `AutoClaude/tools/git-hooks/pre-push` 同段）。
# `tools/bootstrap_core.py` 只建 monorepo 根層一個 `.venv`，AutoClaude 以
# editable（`.[dev,notifications,lint]`）裝進同一個根層 venv；
# `AutoClaude/tools/bootstrap.*` 已不存在，凡存在的 `AutoClaude/.venv` 都是
# 歷史遺留（舊 bootstrap／手動建立／IDE 自建）。修法：根層 `.venv` 優先＋每個
# 候選皆過健康探針才算數，陳舊子專案 venv 只出聲提醒、不再被優先選中。
# DEF-200-297：子專案 venv fallback 已徹底移除（不只是降權）——2026-09-13
# 事故的本質是「撿到了但撿錯」而非「沒撿到」，fail-loud（直接報錯給修法指令）
# 優於繼續留一條可能撿到錯直譯器的退路。

# 健康探針**與 pre-push 不同**：pre-commit 只跑 ruff／check_loc_budget／行數／
# 行尾檢查，不跑 pytest，硬前提只有「Python ≥ 3.11 且真的能啟動」——不判
# `import pytest, xdist`：xdist／pytest 不是本 hook 的前提，硬綁 pytest 套件會讓
# 沒裝 dev extras（只裝了 `.[lint]`）的 commit 誤擋。版本下限只有一個家：
# `tools/dev_start.py::_MIN_PY` ↔ 本檔 source 進來的 SSOT 常數
# `PYTHON_GE_MIN_PROBE`（`tools/lib/windowsapps_guard.sh`）已有鎖同步
# （`tools/tests/test_dev_start.py::TestMinPythonVersionSsotSync`），故直接複用
# 該常數而不是自訂一支新探針。
_py_health() {
  [ -n "$("$1" -c "$PYTHON_GE_MIN_PROBE" 2>/dev/null)" ]
}

# 根層 monorepo 頂層：TOPLEVEL 可能為空（見第 20～26 行 fallback 分支），此處
# 補上同義 fallback（該分支下 $ROOT 已自我定位為 AutoClaude 絕對路徑，
# $ROOT/.. 即 monorepo 根，語意等價於有 TOPLEVEL 時的 "$TOPLEVEL"）。
_MONO="${TOPLEVEL:-$ROOT/..}"

PY=""

# ① 根層 .venv（單一 .venv 設計下的唯一建議位置）。
for _py_cand in "$_MONO/.venv/bin/python" "$_MONO/.venv/Scripts/python.exe"; do
  if [ -x "$_py_cand" ]; then
    if _py_health "$_py_cand"; then
      PY="$_py_cand"
      break
    fi
    echo "[pre-commit] ⚠️  ${_py_cand} 缺 Python ${PYTHON_GE_MIN_MM}+（陳舊 venv？）→ 跳過此候選" >&2
  elif [ -e "$_py_cand" ]; then
    echo "[pre-commit] ⚠️  ${_py_cand} 存在但不可執行（權限異常？）— 退回下一候選" >&2
  fi
done

# ② 子專案 .venv（歷史遺留）：只要存在就出聲一次，**不進候選鏈**（DEF-200-297：
# 子專案 venv 永不被選中，只提醒＋給可直接複製的刪除指令）——bootstrap 只建
# 根層 .venv，本目錄（$ROOT）下的 .venv 只可能是舊 bootstrap／手動建立／IDE
# 自建的殘留物，依單一 .venv 設計（根 ONBOARDING §2.1／DEF-200-294）應刪除。
if [ -x "$ROOT/.venv/bin/python" ] || [ -x "$ROOT/.venv/Scripts/python.exe" ] \
   || [ -e "$ROOT/.venv/bin/python" ] || [ -e "$ROOT/.venv/Scripts/python.exe" ]; then
  echo "[pre-commit] ⚠️  偵測到子專案 venv（$ROOT/.venv）— 單一 .venv 設計下屬歷史遺留，建議刪除：" >&2
  echo "[pre-commit]      Remove-Item -Recurse -Force \"$ROOT/.venv\"   （PowerShell）" >&2
  echo "[pre-commit]      rm -rf \"$ROOT/.venv\"                        （bash）" >&2
fi

# ③ PATH：python → python3（維持 is_real_python_candidate 守門，DEF-101-740 候選鏈）。
if [ -z "$PY" ] && is_real_python_candidate python; then
  if _py_health python; then
    PY=python
  else
    echo "[pre-commit] ⚠️  PATH 上的 python 缺 Python ${PYTHON_GE_MIN_MM}+ → 跳過此候選" >&2
  fi
fi
if [ -z "$PY" ] && is_real_python_candidate python3; then
  if _py_health python3; then
    PY=python3
  else
    echo "[pre-commit] ⚠️  PATH 上的 python3 缺 Python ${PYTHON_GE_MIN_MM}+ → 跳過此候選" >&2
  fi
fi

if [ -z "$PY" ]; then
  echo "[pre-commit] ❌ 找不到可用的直譯器（已試：根層 .venv／PATH python・python3，皆缺席或版本不足）" >&2
  echo "[pre-commit]    修法（擇一，逐字可執行）：" >&2
  echo "[pre-commit]      source .venv/bin/activate   （Windows: .venv\\Scripts\\Activate.ps1）" >&2
  echo "[pre-commit]      uv pip install -e 'AutoClaude/.[dev,notifications,lint]'" >&2
  exit 1
fi

export PYTHONUTF8=1
fail=0

# 1. ruff lint（僅已暫存的 .py；while read 收集為陣列，含空白/非 ASCII 檔名安全，
#    bash 3.2 相容不用 mapfile；quotepath=false 使非 ASCII 檔名不被引號包裹）
staged_py=()
while IFS= read -r f; do
  [ -n "$f" ] && staged_py+=("$f")
done < <(git -c core.quotepath=false diff --cached --name-only --relative --diff-filter=ACMR -- '*.py')
if [ "${#staged_py[@]}" -gt 0 ]; then
  echo "[pre-commit] 1/4 ruff lint（已暫存 .py）"
  if command -v ruff >/dev/null 2>&1; then
    ruff check "${staged_py[@]}" || fail=1
  else
    "$PY" -m ruff check "${staged_py[@]}" || fail=1
  fi
fi

# 2. LOC 預算（靜態掃描，快）— 對齊 CI test/claude-md-budget job
echo "[pre-commit] 2/4 LOC 預算（tools/check_loc_budget.py）"
"$PY" tools/check_loc_budget.py || fail=1

# 3. CLAUDE.md <= 400 行（ADR-SD08-001 / CI hard gate）
echo "[pre-commit] 3/4 CLAUDE.md <= 400 行"
if [ -f CLAUDE.md ]; then
  lines="$(wc -l < CLAUDE.md | tr -d ' ')"
  if [ "$lines" -gt 400 ]; then
    echo "::error:: CLAUDE.md=$lines 行 > 400（ADR-SD08-001）"
    fail=1
  fi
fi

# 4. .sh/.bash 必須 LF 行尾（取證紀律 #8；CRLF 會讓 Docker/Linux bash 噴 $'\r'）
#    while read 逐行處理，含空白/非 ASCII 檔名安全（無引號 for 展開會依空白切字）
echo "[pre-commit] 4/4 .sh/.bash LF 行尾檢查"
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if [ -f "$f" ] && grep -q $'\r' "$f"; then
    echo "::error:: $f 含 CR/CRLF — .sh 必須 LF（取證紀律 #8）"
    fail=1
  fi
done < <(git -c core.quotepath=false diff --cached --name-only --relative --diff-filter=ACMR | grep -E '\.(sh|bash)$' || true)

if [ "$fail" -ne 0 ]; then
  echo "[pre-commit] ❌ 失敗 — 請於本機修復後再 commit"
  echo "           （緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 或 git commit --no-verify）"
  exit 1
fi
echo "[pre-commit] ✅ 全部通過"
exit 0
