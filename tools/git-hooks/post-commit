#!/usr/bin/env bash
# 根層 dispatcher post-commit hook — 委派回 .git/hooks/post-commit（advisory）。
#
# 設計說明：
#   core.hooksPath 一經設定，git 對「所有」hook 種類都只查 dispatcher 目錄，
#   原本安裝於 .git/hooks/ 的 post-commit（例如 AISDLC_SDD 框架 R-9.17.1 的
#   post_commit_drift 告警機制寫入處）會整族靜默失效。本檔把 post-commit 轉呼叫回
#   共享 git dir 下的 hooks/post-commit（存在且可執行才呼叫）。
#   語意為 advisory：無論委派結果如何一律 exit 0（post-commit 本就不能影響 commit）。
#   注意：取 hooks 目錄必須用 --git-common-dir——不可用 --git-path hooks（它會解析
#   core.hooksPath 指回本 dispatcher 目錄，造成自我遞迴）。
#   緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git commit ...
# ---------------------------------------------------------------------------
set -u

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  exit 0
fi

common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
[ -z "${common_dir:-}" ] && exit 0

# 轉絕對路徑（在工作樹頂層執行時 --git-common-dir 可能回相對路徑，如 .git）
case "$common_dir" in
  /*) : ;;
  *)  common_dir="$(cd "$common_dir" 2>/dev/null && pwd)" || exit 0 ;;
esac

target="$common_dir/hooks/post-commit"

# 防呆：若解析出的目標就是本 dispatcher 目錄下的自己（異常設定），跳過避免自我遞迴
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/post-commit"
if [ "$target" = "$self" ]; then
  exit 0
fi

if [ -x "$target" ]; then
  "$target" || true
elif [ -f "$target" ]; then
  # DEF-101-918：Windows 的 Git Bash 上 `[ -x ]` 是「檔首是不是 shebang」的內容
  # 猜測而非權限位元——親測目標檔首多一個 UTF-8 BOM，`[ -x ]` 就由 EXECUTABLE
  # 翻成 NOT-EXEC（且 `chmod +x` 之後仍誤判），上面那道判斷因此靜默 exit 0、
  # 不呼叫任何東西。反向判準：讀檔首 5 位元組，若確為 BOM（EF BB BF）緊接
  # `#!`（23 21），判定為「疑似 BOM 誤判」，改用 bash 直接執行（保持 advisory
  # 語意不變）並印出警告——讓這個失效可被看見，而不是與「本來就沒裝 hook」
  # 混成同一種沉默。誠實劃界：只認 BOM 這一種已重現的具體位元組污染，不宣稱
  # 涵蓋「檔首多任何位元組」的通則情形。
  sig="$(LC_ALL=C head -c 5 "$target" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
  if [ "$sig" = "efbbbf2321" ]; then
    echo "post-commit dispatcher：$target 檔首含 UTF-8 BOM，Git Bash 的 [ -x ] 內容猜測誤判為 NOT-EXEC（DEF-101-918）——改用 bash 直接執行" >&2
    # 剝掉前 3 個 BOM 位元組再交給 bash：不剝的話 shebang 行前多出的 BOM 位元組會
    # 讓 bash 把整行當成一個字面命令去找（拋一句無害但吵人的 No such file），剝掉後
    # `#!...` 行才會被 bash 正常辨識為註解而跳過。
    tail -c +4 "$target" | bash || true
  fi
fi
exit 0
