#!/usr/bin/env bash
# 根層 dispatcher pre-push hook — monorepo 單一 git repo 的 hooks 分流器。
#
# 設計說明：
#   本 repo 是「雙專案 monorepo + 單一 git repo」，core.hooksPath 只有一個值；
#   本 dispatcher 由兩邊安裝腳本統一指向，依「本次 push 範圍涉及的路徑」自動分流，
#   讓兩子專案閘門同時生效：
#     - push 範圍變更含 AutoClaude/  → 執行 AutoClaude/tools/git-hooks/pre-push
#     - push 範圍變更含 AISDLC_SDD/ → 執行 AISDLC_SDD/.githooks/pre-push
#     - root-infra leg（對齊 root-infra-ci.yml 的本地接線；R9 複審：原本純根層變更
#       push 一個閘門都不跑，CI 停擺期間零防護）自 R69 起**快慢分層**：
#         · 快層＝八支守門工具 ＋ `ruff check tools/`（R69 補：對齊 root-infra-ci.yml
#           第 16 道；`tools/ruff.toml` 落地時全 repo 零執行者，同機實測冷 cache 0.02s／
#           熱 cache 0.01s，比任一支守門都便宜），**任何 push 都跑**（含純子專案 push）。理由：這八支
#           守的全是跨子專案不變式（腳本對等／NTFS 路徑／薄殼 hash／帳本互參…），
#           掃描面本來就涵蓋 AutoClaude/tools 與 AISDLC_SDD/scripts；R69 前的觸發
#           條件是「存在不在兩子專案底下的變更路徑」，於是最常見的純子專案 push
#           一支根層守門都不跑（R68-63/65）。同機實測八支合計約 1.0s（逐支
#           0.03~0.27s），與慢層的 111.89s 差兩個數量級，全跑不會逼人 --no-verify。
#         · 慢層＝py_compile 全量 + tools/tests unittest（含數量下限釘選，R10 QA-2），
#           維持「push 範圍變更含根層檔（不在兩子專案底下的任何路徑，如 tools/、
#           docs/、.github/workflows/）」才跑——同機實測 111.89s，無條件跑等於每次
#           子專案 push 都付兩分鐘，與 R67-C18 對整合閘門所做的取捨同一判準。
#         · 「刪除遠端分支」不觸發任一層（無東西可驗證，見下方分流條件）。
#     - push 範圍命中「根層消費檔」（aisdlc-sdd-ci.yml paths 承認的非 AISDLC_SDD/
#       條目，如 tools/check_ntfs_paths.py、.claude/hooks/sdd_hook_router.py）且
#       SDD leg 未觸發 → 補跑 AISDLC_SDD/scripts/tests 回歸鎖（R10 ARCH-1：這些檔
#       的回歸鎖住在 SDD suite，純根層 push 原本永遠不執行它們）
#     - push 範圍命中「整合層閘門本體」（tools/integration_gate.* 三支）→ 實跑
#       tools/integration_gate.sh --skip-full（R67-C18：該閘門在整個自動化層零呼叫端，
#       唯二執行者是兩支已隨 CI 帳務停擺而多輪未跑的 compat-CI ⇒ 實質已死）
#   分流條件（逐行解析 git 傳入 stdin 的 <local_ref> <local_sha> <remote_ref> <remote_sha>）：
#     - remote_sha 全零（新分支）→ 用 git merge-base origin/main <local_sha> 回退為比較基準
#     - local_sha 全零（刪除遠端分支）→ 該行跳過（無需驗證）
#     - 任何無法判定的情況（merge-base 失敗、diff 失敗、stdin 空但仍被呼叫等）
#       → fail-safe：視為兩子專案都有變更（跑全部閘門），寧可多跑不可漏跑
#   stdin 會原樣轉發給各子 hook（printf '%s\n' "$STDIN" | bash <子hook>），
#   使需要讀 stdin 的子 hook 行為不變。
#   緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git push ...  或  git push --no-verify
# ---------------------------------------------------------------------------
set -uo pipefail

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-push dispatcher] AUTOCLAUDE_SKIP_HOOKS=1 → 跳過所有檢查"
  exit 0
fi

# 定位 repo 根：git 執行 hooks 時 cwd＝該工作樹頂層，故以 --show-toplevel 為第一優先
# （linked worktree 內 push 時才會對「該 worktree 的樹」跑檢查，而非安裝時的主 checkout）；
# 取不到才 fallback BASH_SOURCE 自我定位（並印警告）。
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "${TOPLEVEL:-}" ]; then
  echo "[pre-push dispatcher] ⚠ git rev-parse --show-toplevel 失敗 → fallback BASH_SOURCE 自我定位（linked worktree 下可能指向主 checkout）" >&2
  TOPLEVEL="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
rc=0

# R43 Scan-B（DEF-101-353）：WindowsApps 空殼 python 排除 guard（純函式定義，無副作用）。
# shellcheck disable=SC1091
. "$TOPLEVEL/tools/lib/windowsapps_guard.sh"

ZERO_SHA='0000000000000000000000000000000000000000'
STDIN="$(cat)"

run_autoclaude=0
run_sdd=0
run_rootinfra=0
# R69 快層旗標：只要本次 push 有任何「可判定的變更內容」就設 1（刪遠端分支那種
# 已判定的明確跳過不算），與慢層的 run_rootinfra 各自獨立。
run_rootinfra_guards=0
run_integration_gate=0
undeterminable=0
parsed=0
ALL_FILES=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  # 刪除遠端分支：local_sha 全零 → 無東西可驗證，明確跳過（已判定，非 fail-safe 對象）
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    parsed=1
    continue
  fi

  base="$remote_sha"
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # 新分支：以 origin/main 的 merge-base 為比較基準
    if ! base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || [ -z "$base" ]; then
      undeterminable=1
      continue
    fi
  fi

  # -c core.quotepath=false：非 ASCII 檔名不被引號包裹，前綴比對不逃逸
  # --no-renames：rename 偵測只列「新路徑」一條，把檔案移出子專案時舊路徑消失 →
  # 來源子專案閘門靜默漏跑（fail-open）；停用後拆成 A+D 兩條路徑，舊路徑重新可見
  if ! files="$(git -c core.quotepath=false diff --name-only --no-renames "$base" "$local_sha" 2>/dev/null)"; then
    undeterminable=1
    continue
  fi
  parsed=1
  # R69：走到這裡代表本行的變更範圍已成功判定 ⇒ 快層守門必跑（不論命中哪個子專案）。
  run_rootinfra_guards=1

  # 純 bash case 前綴比對（不可用 printf | grep -q —— 變更清單 >64KB 且命中在前段時
  # grep -q 提早退出令 printf 收 SIGPIPE，pipefail 判整條管線非零 → 閘門靜默漏跑）
  case $'\n'"$files" in *$'\n'AutoClaude/*)  run_autoclaude=1 ;; esac
  case $'\n'"$files" in *$'\n'AISDLC_SDD/*) run_sdd=1 ;; esac

  # 累積全部變更路徑（供下方根層消費檔比對，R10 ARCH-1）
  ALL_FILES="${ALL_FILES}
$files"

  # 根層檔偵測：存在任一「不在兩子專案底下」的變更路徑即觸發 root-infra leg。
  # 「不以某前綴開頭」無法用單一 case 對整個 blob 判定 → 逐行 case（bash 3.2 相容，
  # 同樣不走 printf | grep 管線；內層 heredoc 有自己的 fd，不干擾外層 stdin 迴圈）
  while IFS= read -r f; do
    [ -z "${f:-}" ] && continue
    case "$f" in
      AutoClaude/*|AISDLC_SDD/*) ;;
      *) run_rootinfra=1 ;;
    esac
  done <<FILES_EOF
$files
FILES_EOF
done <<EOF
$STDIN
EOF

# fail-safe：任何無法判定的情況（merge-base/diff 失敗，或無任何行可判定——含 stdin 空。
# 空 stdin 正是 pre-commit 框架等工具吃掉 stdin 的危險情境，一律 fail-safe 而非靜默放行）
# → 視為兩子專案都有變更（跑全部閘門），寧可多跑不可漏跑
if [ "$undeterminable" -eq 1 ] || [ "$parsed" -eq 0 ]; then
  echo "[pre-push dispatcher] ⚠ 無法判定 push 範圍變更 → fail-safe：四 leg 閘門全跑（兩子專案 + root-infra + 整合閘門）"
  run_autoclaude=1
  run_sdd=1
  run_rootinfra=1
  run_rootinfra_guards=1
  run_integration_gate=1
fi

# 根層消費檔偵測（R10 ARCH-1 / DEF-101-125）：aisdlc-sdd-ci.yml paths 承認的
# 非 AISDLC_SDD/ 條目（NTFS 閘、pre-commit、settings.json、sdd_hook_router.py 等）
# 之回歸鎖住在 AISDLC_SDD/scripts/tests/，但 SDD leg 只在 push 涉 AISDLC_SDD/ 時
# 觸發——CI 停擺期間改壞這些檔可零機械訊號直推 main。清單機械讀取該 yml
# （單一真相源，勿手抄第二份）；SDD leg 已觸發時 ci-gate.sh 內含 scripts/tests，
# 免重複跑。消費檔條目以 bash case glob 語意比對（現行皆字面路徑）。
run_sdd_consumer=0
if [ "$run_sdd" -eq 0 ] && [ -n "$ALL_FILES" ]; then
  SDD_CI_YML="$TOPLEVEL/.github/workflows/aisdlc-sdd-ci.yml"
  if [ ! -f "$SDD_CI_YML" ]; then
    echo "[pre-push dispatcher] ❌ 找不到 ${SDD_CI_YML}（根層消費檔清單來源；hooks 體系損壞）" >&2
    rc=1
  else
    consumer_paths="$( { grep -E '^[[:space:]]*-[[:space:]]*"' "$SDD_CI_YML" || true; } \
      | sed 's/^[^"]*"//; s/".*$//' \
      | { grep -v '^AISDLC_SDD/' || true; } \
      | { grep -v '^\.github/workflows/' || true; } \
      | sort -u)"
    while IFS= read -r f; do
      [ -z "${f:-}" ] && continue
      # 清單 SSOT 自身變更也觸發（R10 二審 SD P3）：守這份清單的 meta 鎖
      # （test_ci_paths_cover_root_consumers）住在 SDD suite——CI 停擺期間單獨
      # 改壞本 yml 直推 main 原本零機械訊號、且會讓後續消費檔 push 漏跑本 leg。
      case "$f" in
        .github/workflows/aisdlc-sdd-ci.yml) run_sdd_consumer=1 ;;
      esac
      while IFS= read -r c; do
        [ -z "${c:-}" ] && continue
        case "$f" in
          $c) run_sdd_consumer=1 ;;
        esac
      done <<CONSUMER_EOF
$consumer_paths
CONSUMER_EOF
    done <<ALLFILES_EOF
$ALL_FILES
ALLFILES_EOF
  fi
fi

# 整合閘門偵測（R67-C18）：tools/integration_gate.{sh,ps1,_core.py} 是 monorepo
# 「整合層」閘門本體（5 stage：兩子專案 gate + SDD bridge 煙霧 + 回退驗證 + cc-switch
# A/B）。R67 全庫普查實測：它在整個自動化層**零呼叫端**，唯二執行者是
# .github/workflows/{macos,windows}-compat-ci.yml 各一行，而兩支 compat-CI 因 CI 帳務
# 停擺（DEF-101-081）多輪未真正執行 ⇒「雲端是唯一執行者的東西＝實質已死」。
#
# 取捨（為何是「路徑範圍觸發」而非無條件跑）：--skip-full 本機實測 2.79s，相對本 leg
# 既有的 root-infra unittest（同機實測 111.89s）只佔 2.5%；但對「完全沒碰整合閘門」的
# 日常 push 那是純粹白付，而本 repo 的既有共識是 pre-push 一旦變慢，開發者會改用
# --no-verify 繞過、整條防線一起蒸發（見 L413 附近 dispatcher 測試 WHY 的同款論證）。
# 故比照上方消費檔 leg 的路徑範圍觸發慣例：只在 push 真的動到閘門本體時實跑，日常
# push 零成本。全套（含 [1/5][2/5] 兩子專案完整 CI 閘門，分鐘級）刻意不放 pre-push。
#
# 路徑觸發抓不到的另兩種腐爛（閘門沒被改、但它指向的東西壞了；編排語意被改成吞掉
# 失敗）改由 tools/tests/test_find_git_bash_parity.py 的 TestIntegrationGateStageTargets
# （stage 目標實際存在）與 TestIntegrationGateOrchestration（編排語意／失敗傳播）在
# **每次**根層 push 隨上方 leg ② 的 run_root_unittests 執行時守——兩者互補，缺一不可。
# 🔴 R67 round 2（QA-R67-03）訂正：本段原指名一支名為 test_integration_gate_local_carrier.py
# 的鎖檔（此處刻意不寫成路徑形態，見下方掃描器）——那支檔案**從未存在**（`ls` rc=1、全庫
# find 零命中）。真正的守門依 DEF-101-561③ 併進了
# integration_gate_core 既有的姊妹鎖檔（不另開新檔），故改為指名該檔與其類別。死信形態見
# CrossPlatform_Scan_Dimensions.md 硬規則③ 第一點；現由 test_pre_push_dispatcher.py 的
# TestNamedCarrierFilesActuallyExist 機械守住（指名不存在的鎖檔即紅）。
#
# 比對用 glob 前綴而非逐一列舉字面路徑：tools/tests/test_root_infra_parity.py 對
# pre-push 非註解行出現的 `tools/*.py` 字面值有「必須在 root-infra-ci.yml 有對等守門」
# 的雙向集合斷言，逐字寫出 _core.py 會誤入該集合。
if [ -n "$ALL_FILES" ]; then
  while IFS= read -r f; do
    [ -z "${f:-}" ] && continue
    case "$f" in
      tools/integration_gate*) run_integration_gate=1 ;;
    esac
  done <<IGFILES_EOF
$ALL_FILES
IGFILES_EOF
fi

if [ "$run_autoclaude" -eq 1 ]; then
  if [ -f "$TOPLEVEL/AutoClaude/tools/git-hooks/pre-push" ]; then
    echo "[pre-push dispatcher] push 範圍含 AutoClaude/ → 執行 AutoClaude pre-push"
    printf '%s\n' "$STDIN" | bash "$TOPLEVEL/AutoClaude/tools/git-hooks/pre-push" || rc=1
  else
    # 子 hook 應存在卻缺失＝hooks 體系損壞 → fail-loud，拒絕放行
    echo "[pre-push dispatcher] ❌ 子 hook 缺失：$TOPLEVEL/AutoClaude/tools/git-hooks/pre-push（hooks 體系損壞）" >&2
    rc=1
  fi
fi

if [ "$run_sdd" -eq 1 ]; then
  if [ -f "$TOPLEVEL/AISDLC_SDD/.githooks/pre-push" ]; then
    echo "[pre-push dispatcher] push 範圍含 AISDLC_SDD/ → 執行 AISDLC_SDD pre-push"
    printf '%s\n' "$STDIN" | bash "$TOPLEVEL/AISDLC_SDD/.githooks/pre-push" || rc=1
  else
    # 子 hook 應存在卻缺失＝hooks 體系損壞 → fail-loud，拒絕放行
    echo "[pre-push dispatcher] ❌ 子 hook 缺失：$TOPLEVEL/AISDLC_SDD/.githooks/pre-push（hooks 體系損壞）" >&2
    rc=1
  fi
fi

# root-infra leg（R9 複審接線）：純根層變更（tools/、docs/、workflows 等）原本
# 一個閘門都不跑——root-infra-ci.yml 的守門在 CI 帳單停擺期間本地零接線。
# 內容對齊 root-infra-ci.yml：py_compile 全 tools/*.py + tools/tests unittest +
# 八支守門工具；失敗累積進 rc（不中斷其他 leg），python 缺席 fail-loud 不軟跳過。
# （R56 訂正：R55 由五支增為六支時本行漏改，與 L12／L211 及實際迴圈不一致；
#  三處計數宣稱現由 test_root_infra_parity.py::test_guard_count_claims_match_loop
#  機械斷言與迴圈項數相等，不再靠人工同步。）
if [ "$run_rootinfra" -eq 1 ] || [ "$run_rootinfra_guards" -eq 1 ]; then
  if [ "$run_rootinfra" -eq 1 ]; then
    echo "[pre-push dispatcher] push 範圍含根層檔 → 執行 root-infra 閘門（快層守門 + 慢層 py_compile/unittest）"
  else
    echo "[pre-push dispatcher] root-infra 快層守門（跨子專案不變式，任何 push 皆跑）"
  fi
  if ! is_real_python_candidate python; then
    echo "[pre-push dispatcher] ❌ 找不到 python — root-infra 閘門無法執行；請先啟用 venv（Windows: .venv/Scripts/activate；macOS/Linux: source .venv/bin/activate，見 ONBOARDING.md §3）" >&2
    rc=1
  else
    (
      cd "$TOPLEVEL" || exit 1
      leg_rc=0
      # ①② 為**慢層**（同機實測 111.89s）：僅在 push 真的動到根層檔時執行。
      if [ "$run_rootinfra" -eq 1 ]; then
      # ① 根層 Python 全量 py_compile：tools/ + .claude/hooks/（R10 ARCH-1 補：
      #    sdd_hook_router.py 等根層消費檔有 CI paths 覆蓋，本地原本連語法檢查
      #    都沒有）（find -exec：免 mapfile、空白檔名安全；py_compile 對多檔
      #    逐一編譯、任一失敗即非零）
      pydirs="tools"
      [ -d .claude/hooks ] && pydirs="$pydirs .claude/hooks"
      if ! find $pydirs -name '*.py' -not -path '*/__pycache__/*' -exec python -m py_compile {} +; then
        echo "[pre-push dispatcher] ❌ root-infra：根層 Python py_compile 失敗" >&2
        leg_rc=1
      fi
      # ② tools/tests 單元測試（R10 QA-2：改走 run_root_unittests.py——裸 discover
      #    對「發現 0 個測試」回 rc=0，數量下限釘選堵住此 fail-open）
      if ! python tools/run_root_unittests.py; then
        echo "[pre-push dispatcher] ❌ root-infra：tools/tests unittest 失敗" >&2
        leg_rc=1
      fi
      fi
      # ③ 八支守門工具（**快層**，R69 起任何 push 皆跑，見檔頭）（逐支跑完累積，不因單支失敗提早退出；R13 增
      #    check_pytest_baseline_sites.py——pytest 基線數字站點鎖，對齊 CI 第 11 道；
      #    R55 增 check_gha_action_versions.py——GitHub Actions 版本一致性鎖，
      #    對齊 CI 第 12 道；R60 增 archive_defect_log.py --check——帳本保全稽核，
      #    對齊 CI 第 13 道。R60 round 1 四方複審 ARCH-R60-02／QA-R60-01 實證：帳本
      #    **體積**硬閘（check_defect_log_crossref.py）本來就在這個迴圈裡，而同一份
      #    帳本的**保全**稽核卻零接線——「可重跑但沒有任何閘門看它的 rc」與「不可
      #    重跑」是同一個病的兩種形狀，故本輪把 rc 真正接上。）
      #    迴圈項改為「指令字串」（可帶子指令參數），故 python 後刻意不加引號以分詞。
      for guard in "tools/check_script_parity.py" "tools/check_ntfs_paths.py" \
                   "tools/check_defect_log_crossref.py" "tools/check_wrapper_thinness.py" \
                   "tools/check_pytest_baseline_sites.py" "tools/check_gha_action_versions.py" \
                   "tools/archive_defect_log.py --check" \
                   "tools/sync_onboarding_baselines.py --check-snapshot"; do
        # shellcheck disable=SC2086  # 刻意分詞：項目可帶子指令（archive_defect_log --check）
        if ! python $guard; then
          echo "[pre-push dispatcher] ❌ root-infra：$guard 失敗" >&2
          leg_rc=1
        fi
      done
      # ④ 根層護欄層 ruff（**快層**，R69）：對齊 root-infra-ci.yml 第 16 道。
      #    `tools/ruff.toml` 落地當下全 repo 零執行者——設定檔正確但沒人跑它，
      #    等於把假綠從「ruff 出廠預設」換成「根本沒人跑 ruff」，本段即該道的本地執行者。
      #    刻意不寫 `--config tools/ruff.toml`：帶 `--config` 會把 project root 挪到 cwd，
      #    per-file-ignores 與 isort src 判定全部錯位（同機實測 140 errors vs 0），
      #    走 ruff 自己的「由檔往上尋找」才會解析到 tools/ruff.toml（判定見
      #    tools/tests/test_subprocess_encoding_hygiene.py::TestRootToolsLintPolicy）。
      #    同機實測：冷 cache 0.02s／熱 cache 0.01s——比快層任一支守門都便宜。
      #    ruff 缺席＝fail-loud（同本 leg 對 python 的處置）：軟跳過會讓本道退回
      #    「宣告有、執行者無」的原病，而 ruff 本來就在 ONBOARDING 的開發環境安裝清單內。
      #    🔴 R69 終審 P1：ruff 的 `warning:` 走 **stderr 且不改變 rc**——`Invalid noqa
      #    directive`（指令寫壞 ⇒ 該行其實完全沒被豁免）正是這樣落地無人消費，本 repo
      #    因此真的留了一個壞豁免整輪沒人發現（tools/tests/test_no_invalid_escape_sequences.py
      #    當時還以整檔自我豁免掩護它）。本段改為收下 stderr 並在有 `warning:` 時 fail：
      #    「只看 rc」等於自願對工具說出口的話裝作沒聽見。
      #    `--no-cache` 不可省（同機實測）：該 warning **只在冷 cache 時印**，第二次跑起
      #    就靜默 ⇒ 不帶它的話本道的鑑別力取決於「這台機器剛好有沒有 cache」。冷跑 0.02s。
      if ! command -v ruff >/dev/null 2>&1; then
        echo "[pre-push dispatcher] ❌ root-infra：找不到 ruff — 根層護欄層 lint 無法執行；請先啟用 .venv 並安裝開發相依（cd AutoClaude && uv pip install -e '.[dev,notifications]'）" >&2
        leg_rc=1
      else
        _ruff_err="$(mktemp)"
        if ! ruff check tools/ --no-cache 2>"$_ruff_err"; then
          cat "$_ruff_err" >&2
          echo "[pre-push dispatcher] ❌ root-infra：ruff check tools/ 失敗（設定＝tools/ruff.toml）" >&2
          leg_rc=1
        elif grep -q '^warning:' "$_ruff_err"; then
          cat "$_ruff_err" >&2
          echo "[pre-push dispatcher] ❌ root-infra：ruff 印出 warning（rc=0 但 warning 不得靜默吞掉；最常見是壞掉的 noqa 指令＝該行根本沒被豁免）" >&2
          leg_rc=1
        else
          cat "$_ruff_err" >&2
        fi
        rm -f "$_ruff_err"
      fi
      exit $leg_rc
    ) || rc=1
  fi
fi

# 根層消費檔 leg（R10 ARCH-1 / DEF-101-125）：於「消費檔命中且 SDD leg 未觸發」時
# 補跑 AISDLC_SDD/scripts/tests（test_ntfs_length_gate 六道防線、hook wiring cwd
# 安全、router 家族等回歸鎖的唯一住址）。
if [ "$run_sdd_consumer" -eq 1 ]; then
  echo "[pre-push dispatcher] push 涉根層消費檔（aisdlc-sdd-ci.yml paths）→ 執行 AISDLC_SDD/scripts/tests 回歸鎖"
  if ! is_real_python_candidate python; then
    echo "[pre-push dispatcher] ❌ 找不到 python — 消費檔回歸鎖無法執行；請先啟用 venv（見 ONBOARDING.md §3）" >&2
    rc=1
  # `-rs`（R59 ARCH-R59-NB1）：與 AISDLC_SDD/scripts/ci-gate.sh 跑的是**同一套**
  # scripts/tests，本輪若只補 ci-gate.sh 那一邊，就是本輪自己在抓的「N 份複本只改 1 份」。
  elif ! (cd "$TOPLEVEL/AISDLC_SDD" && python -m pytest scripts/tests -q -rs); then
    echo "[pre-push dispatcher] ❌ 根層消費檔回歸鎖失敗（AISDLC_SDD/scripts/tests）" >&2
    rc=1
  fi
fi

# 整合閘門 leg（R67-C18）：於「push 動到整合層閘門本體」時實跑該閘門的快速迴圈模式。
# 用 --skip-full（[3/5]+[4/5]+[5/5]）而非全套：[1/5]/[2/5] 是兩子專案各自的完整 CI
# 閘門，push 若同時涉及那兩個子專案，上方對應 leg 已經跑過它們；在這裡再跑一次是
# 分鐘級的純重複。閘門檔應存在卻缺失＝閘門體系損壞 → fail-loud（同子 hook 缺失語意）。
if [ "$run_integration_gate" -eq 1 ]; then
  echo "[pre-push dispatcher] push 涉整合層閘門本體 → 實跑整合閘門（--skip-full）"
  if [ ! -f "$TOPLEVEL/tools/integration_gate.sh" ]; then
    echo "[pre-push dispatcher] ❌ 整合閘門缺失：$TOPLEVEL/tools/integration_gate.sh（閘門體系損壞）" >&2
    rc=1
  elif ! is_real_python_candidate python; then
    echo "[pre-push dispatcher] ❌ 找不到 python — 整合閘門無法執行；請先啟用 venv（見 ONBOARDING.md §3）" >&2
    rc=1
  elif ! (cd "$TOPLEVEL" && bash tools/integration_gate.sh --skip-full); then
    echo "[pre-push dispatcher] ❌ 整合閘門未通過（tools/integration_gate.sh --skip-full）" >&2
    rc=1
  fi
fi

exit $rc
