#!/usr/bin/env bash
# 根層 dispatcher pre-push hook — monorepo 單一 git repo 的 hooks 分流器。
#
# 設計說明：
#   本 repo 是「雙專案 monorepo + 單一 git repo」，core.hooksPath 只有一個值；
#   本 dispatcher 由兩邊安裝腳本統一指向，依「本次 push 範圍涉及的路徑」自動分流，
#   讓兩子專案閘門同時生效：
#     - push 範圍變更含 AutoClaude/  → 執行 AutoClaude/tools/git-hooks/pre-push
#     - push 範圍變更含 AISDLC_SDD/ → 執行 AISDLC_SDD/.githooks/pre-push
#   分流條件（逐行解析 git 傳入 stdin 的 <local_ref> <local_sha> <remote_ref> <remote_sha>）：
#     - remote_sha 全零（新分支）→ 用 git merge-base origin/main <local_sha> 回退為比較基準
#     - local_sha 全零（刪除遠端分支）→ 該行跳過（無需驗證）
#     - 任何無法判定的情況（merge-base 失敗、diff 失敗、stdin 空但仍被呼叫等）
#       → fail-safe：視為兩子專案都有變更（跑全部閘門），寧可多跑不可漏跑
#   stdin 會原樣轉發給各子 hook（printf '%s\n' "$STDIN" | bash <子hook>），
#   使需要讀 stdin 的子 hook 行為不變。
#   緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git push ...  或  git push --no-verify
# ---------------------------------------------------------------------------
set -uo pipefail

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-push dispatcher] AUTOCLAUDE_SKIP_HOOKS=1 → 跳過所有檢查"
  exit 0
fi

# 定位 repo 根：git 執行 hooks 時 cwd＝該工作樹頂層，故以 --show-toplevel 為第一優先
# （linked worktree 內 push 時才會對「該 worktree 的樹」跑檢查，而非安裝時的主 checkout）；
# 取不到才 fallback BASH_SOURCE 自我定位（並印警告）。
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "${TOPLEVEL:-}" ]; then
  echo "[pre-push dispatcher] ⚠ git rev-parse --show-toplevel 失敗 → fallback BASH_SOURCE 自我定位（linked worktree 下可能指向主 checkout）" >&2
  TOPLEVEL="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
rc=0

ZERO_SHA='0000000000000000000000000000000000000000'
STDIN="$(cat)"

run_autoclaude=0
run_sdd=0
undeterminable=0
parsed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  # 刪除遠端分支：local_sha 全零 → 無東西可驗證，明確跳過（已判定，非 fail-safe 對象）
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    parsed=1
    continue
  fi

  base="$remote_sha"
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # 新分支：以 origin/main 的 merge-base 為比較基準
    if ! base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || [ -z "$base" ]; then
      undeterminable=1
      continue
    fi
  fi

  # -c core.quotepath=false：非 ASCII 檔名不被引號包裹，前綴比對不逃逸
  # --no-renames：rename 偵測只列「新路徑」一條，把檔案移出子專案時舊路徑消失 →
  # 來源子專案閘門靜默漏跑（fail-open）；停用後拆成 A+D 兩條路徑，舊路徑重新可見
  if ! files="$(git -c core.quotepath=false diff --name-only --no-renames "$base" "$local_sha" 2>/dev/null)"; then
    undeterminable=1
    continue
  fi
  parsed=1

  # 純 bash case 前綴比對（不可用 printf | grep -q —— 變更清單 >64KB 且命中在前段時
  # grep -q 提早退出令 printf 收 SIGPIPE，pipefail 判整條管線非零 → 閘門靜默漏跑）
  case $'\n'"$files" in *$'\n'AutoClaude/*)  run_autoclaude=1 ;; esac
  case $'\n'"$files" in *$'\n'AISDLC_SDD/*) run_sdd=1 ;; esac
done <<EOF
$STDIN
EOF

# fail-safe：任何無法判定的情況（merge-base/diff 失敗，或無任何行可判定——含 stdin 空。
# 空 stdin 正是 pre-commit 框架等工具吃掉 stdin 的危險情境，一律 fail-safe 而非靜默放行）
# → 視為兩子專案都有變更（跑全部閘門），寧可多跑不可漏跑
if [ "$undeterminable" -eq 1 ] || [ "$parsed" -eq 0 ]; then
  echo "[pre-push dispatcher] ⚠ 無法判定 push 範圍變更 → fail-safe：兩子專案閘門全跑"
  run_autoclaude=1
  run_sdd=1
fi

if [ "$run_autoclaude" -eq 1 ]; then
  if [ -f "$TOPLEVEL/AutoClaude/tools/git-hooks/pre-push" ]; then
    echo "[pre-push dispatcher] push 範圍含 AutoClaude/ → 執行 AutoClaude pre-push"
    printf '%s\n' "$STDIN" | bash "$TOPLEVEL/AutoClaude/tools/git-hooks/pre-push" || rc=1
  else
    # 子 hook 應存在卻缺失＝hooks 體系損壞 → fail-loud，拒絕放行
    echo "[pre-push dispatcher] ❌ 子 hook 缺失：$TOPLEVEL/AutoClaude/tools/git-hooks/pre-push（hooks 體系損壞）" >&2
    rc=1
  fi
fi

if [ "$run_sdd" -eq 1 ]; then
  if [ -f "$TOPLEVEL/AISDLC_SDD/.githooks/pre-push" ]; then
    echo "[pre-push dispatcher] push 範圍含 AISDLC_SDD/ → 執行 AISDLC_SDD pre-push"
    printf '%s\n' "$STDIN" | bash "$TOPLEVEL/AISDLC_SDD/.githooks/pre-push" || rc=1
  else
    # 子 hook 應存在卻缺失＝hooks 體系損壞 → fail-loud，拒絕放行
    echo "[pre-push dispatcher] ❌ 子 hook 缺失：$TOPLEVEL/AISDLC_SDD/.githooks/pre-push（hooks 體系損壞）" >&2
    rc=1
  fi
fi

exit $rc
