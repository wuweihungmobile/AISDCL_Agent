#!/usr/bin/env bash
# 根層 dispatcher pre-commit hook — monorepo 單一 git repo 的 hooks 分流器。
#
# 設計說明：
#   本 repo 是「雙專案 monorepo + 單一 git repo」，core.hooksPath 只有一個值；
#   過去兩子專案的 hooks 互斥擇一是設計缺陷。本 dispatcher 由兩邊安裝腳本
#   （AutoClaude/tools/install_git_hooks.* 與 AISDLC_SDD/scripts/install-hooks.*）
#   統一指向，依「本次 commit 涉及的路徑」自動分流，讓兩子專案閘門同時生效：
#     - 暫存變更含 AutoClaude/  → 執行 AutoClaude/tools/git-hooks/pre-commit
#     - 暫存變更含 AISDLC_SDD/ → 執行 AISDLC_SDD/.githooks/pre-commit（存在才執行；
#       目前 AISDLC_SDD 僅提供 pre-push，無 pre-commit，正常跳過）
#   緊急跳過：AUTOCLAUDE_SKIP_HOOKS=1 git commit ...  或  git commit --no-verify
# ---------------------------------------------------------------------------
set -uo pipefail

if [ "${AUTOCLAUDE_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-commit dispatcher] AUTOCLAUDE_SKIP_HOOKS=1 → 跳過所有檢查"
  exit 0
fi

# 定位 repo 根：git 執行 hooks 時 cwd＝該工作樹頂層，故以 --show-toplevel 為第一優先
# （linked worktree 內 commit 時才會對「該 worktree 的樹」跑檢查，而非安裝時的主 checkout）；
# 取不到才 fallback BASH_SOURCE 自我定位（並印警告）。
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "${TOPLEVEL:-}" ]; then
  echo "[pre-commit dispatcher] ⚠ git rev-parse --show-toplevel 失敗 → fallback BASH_SOURCE 自我定位（linked worktree 下可能指向主 checkout）" >&2
  TOPLEVEL="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
rc=0

# 分流判定：純 bash case 前綴比對（不可用 printf | grep -q —— 變更清單 >64KB 且命中在
# 前段時 grep -q 提早退出令 printf 收 SIGPIPE，pipefail 判整條管線非零 → 閘門靜默漏跑）。
# -c core.quotepath=false：非 ASCII 檔名不被引號包裹，前綴比對不逃逸。
# --no-renames：rename 偵測只列「新路徑」一條，若把檔案移出子專案（如 AutoClaude/x → docs/x），
# 舊路徑消失 → 來源子專案閘門靜默漏跑（fail-open）。停用 rename 偵測使其拆成 A+D 兩條路徑，
# 舊路徑重新可見、來源子專案照常命中分流。
run_autoclaude=0
run_sdd=0
run_root_infra=0
if changed="$(git -c core.quotepath=false diff --cached --name-only --no-renames)"; then
  case $'\n'"$changed" in *$'\n'AutoClaude/*)  run_autoclaude=1 ;; esac
  case $'\n'"$changed" in *$'\n'AISDLC_SDD/*) run_sdd=1 ;; esac
  # 根層基建 leg（A4）：根層 tools/ / .gitattributes / .editorconfig / .github/ 有變更
  # 即觸發（過去這些基建自身變更零閘門，改壞 dispatcher/bootstrap 只能事後發現）
  case $'\n'"$changed" in *$'\n'tools/*)          run_root_infra=1 ;; esac
  case $'\n'"$changed" in *$'\n'.github/*)        run_root_infra=1 ;; esac
  case $'\n'"$changed" in *$'\n'.gitattributes*)  run_root_infra=1 ;; esac
  case $'\n'"$changed" in *$'\n'.editorconfig*)   run_root_infra=1 ;; esac
else
  # git diff 失敗（rc≠0）→ 無法判定變更範圍 → fail-safe：兩子專案閘門全跑，寧可多跑不可漏跑
  echo "[pre-commit dispatcher] ⚠ git diff --cached 失敗 → fail-safe：兩子專案閘門全跑"
  run_autoclaude=1
  run_sdd=1
fi

# ── NTFS 敵意檔名防護閘（A3）─────────────────────────────────────────────
# 本 repo 為 macOS ⇄ Windows 雙平台開發：macOS(APFS) 允許的檔名在 Windows(NTFS)
# checkout 時會直接炸掉（無法建檔）或靜默碰撞（大小寫不敏感覆蓋）。凡本次 commit
# 新增（A/C）的路徑任一命中即 fail-loud 擋下（正確性閘，CI 環境亦不跳過）：
#   1. 路徑任一段含 < > : " | ? * 或控制字元，或以空白/句點結尾（NTFS 不允許）
#   2. 任一段去副檔名、再剝除尾隨空白後（不分大小寫）為 Windows 保留裝置名
#      CON/PRN/AUX/NUL/COM0~9/LPT0~9/CONIN$/CONOUT$（尾隨空白剝除＝R57 修正、
#      CONIN$/CONOUT$＝R60 補齊，兩者理由見 _ntfs_seg_bad 內註解）
#   3. 大小寫碰撞：新增路徑 lowercase 後與既有 tracked 路徑重複但原字串不同
#      （NTFS 大小寫不敏感 → checkout 時兩檔互相覆蓋）
#   4. MAX_PATH 保守長度閘（DEF-101-039）：Windows 未開 core.longpaths 時絕對路徑上限
#      MAX_PATH=260 UTF-16 單位（含結尾 NUL，可用 259）；預留 clone 前綴 59 字元＋NUL
#      （C:\Users\<user>\...\<repo>\，259−200＝59）→ repo 相對路徑 >200 字元擋下、
#      >180 字元預警。長度＝code point 數：以「刪去 UTF-8 連續位元組（0x80-0xBF）後
#      的位元組數」計，locale 無關（第五輪 DEF-101 修正：${#f} 在 C locale——GUI git
#      client 常見——退化為位元組數，CJK 路徑 67 字元即誤擋，且與 CI 版 len() 分歧）。
#   5. 目錄段層級碰撞（R67-A2）：新增路徑的**每一層目錄前綴**與既有 tracked 目錄前綴
#      比對，僅大小寫不同即擋下。第 3 項拿整行比對，對「目錄段拼法不同、basename
#      完全不重複」結構上失明——本 repo 曾因此靜默長出兩對 Archive/archive 目錄達 6 週。
#      實作與 rationale 見下方該段內註解。
# 範圍差異（R67-B16，刻意不對稱）：CI 版 tools/check_ntfs_paths.py 另有第 6 項
# 「index 路徑須為 NFC」，**本 hook 刻意不鏡射**——mac 側 git add 恆 precompose、
# Windows/NTFS 本身即 NFC，NFD 只能由 Linux/GitHub web/plumbing 進來而那三條路都不經過
# pre-commit，鏡射進來是零收益死碼。此決策由 tools/tests/
# test_ntfs_trailing_space_device_name.py::TestNfcAxisScopeIsCiOnlyByDesign 機械釘住。
# 另註：merge/rebase/cherry-pick 不經 pre-commit（git 無此 hook 觸發點），本閘 1~4 項
# 皆由 root-infra-ci（全變更觸發）之 check_ntfs_paths.py 雲端兜底。
# bash 3.2 相容：無 assoc array / ${var,,}，以 case pattern + tr + grep -iFx 實作。
_ntfs_seg_bad() {  # $1=完整路徑；有問題 → stdout 印原因並回 0，乾淨 → 回 1
  local p="$1" rest seg base up
  # 控制字元（整條路徑一次檢查；LC_ALL=C 使 [:cntrl:] 按位元組判定）
  if printf '%s' "$p" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    echo "含控制字元"
    return 0
  fi
  rest="$p"
  while :; do
    seg="${rest%%/*}"
    case "$seg" in
      *'<'*|*'>'*|*':'*|*'"'*|*'|'*|*'?'*|*'*'*|*'\'*)
        echo "路徑段「${seg}」含 Windows 不允許字元（< > : \" | ? * \\）"
        return 0 ;;
      *' '|*'.')
        echo "路徑段「${seg}」以空白或句點結尾（NTFS 不允許）"
        return 0 ;;
    esac
    base="${seg%%.*}"   # 去（第一個點起的）副檔名；Windows 對 CON.txt 一樣視為保留名
    # R57 修正（DEF-101-B1）：再剝除 base 的尾隨空白。原本 `CON .txt` 的 base 是
    # 「CON 」（帶尾隨空白），case pattern CON 不匹配而放行；上方「以空白/句點結尾」
    # 只看整段（結尾是 t）也不攔 → 完全逃逸。Win32 解析裝置名時會忽略基底名後的
    # 尾隨空白，故此形態在 Windows 上仍撞裝置名。CI 對等實作 tools/check_ntfs_paths.py
    # 的 `.rstrip(" ")` 同語意。bash 3.2 無 extglob 保證，以 while + ${var% } 逐字剝。
    while [ "${base% }" != "$base" ]; do base="${base% }"; done
    up="$(printf '%s' "$base" | tr '[:lower:]' '[:upper:]')"
    # R60 補齊 CONIN$／CONOUT$：git for Windows 的 core.protectNTFS 視其為 Invalid path，
    # 一旦入庫（mac/Linux 側 protectNTFS 預設不啟用），每一台 Windows clone 的 checkout
    # 會**整體**失敗（本機實測 rc=128、工作樹全空），比單檔失敗嚴重。CLOCK$ 實測 git
    # ACCEPT 且 clone 正常，故刻意不納入。CI 對等實作 tools/check_ntfs_paths.py 的
    # `_RESERVED_RE` 有完整實測紀錄。bash 3.2 相容：`$` 在 case glob 內以單引號界定成
    # 字面值（裸寫 `CONIN$|…` 的 `$|` 依賴「$ 後接非展開字元視為字面」的邊角行為，不寫）。
    # 前導空白（' CON.txt'）刻意不處理——git 與 Win32 皆視為正常檔名，加擋只生偽陽性，
    # 實測與樣本鎖見 check_ntfs_paths.py `_RESERVED_RE` 上方註解。
    # 🔴 四個基本裝置名（CON、PRN、AUX、NUL）必須相鄰、新名一律加在尾端：
    # test_windows_forbidden_filename_parity.py 的 repo-wide 錨①要求四者依序出現且間隙
    # ≤5 字元（R60 初版插在中間，實測讓三處實作同時掉出該錨而無任何訊號）。
    # case 交替順序不影響比對結果。
    # R68：追加 MS 官方保留名清單明列的上標變體。刻意逐個列出而非寫 `COM[¹²³]`——
    # bash 3.2 的 glob bracket 在 C locale 下是**逐位元組**比對，`[¹²³]`（UTF-8 共 6 bytes）
    # 會退化成單位元組集合而永不匹配 3 bytes 的 `COM¹`（本機實測）。上標不受
    # `tr '[:lower:]' '[:upper:]'` 影響，故 `com¹` 亦命中。🔴 證據等級＝官方文件＋靜態
    # 分析，非 Windows 真機實測（本輪無真機），完整取捨見 check_ntfs_paths.py `_RESERVED_RE`。
    case "$up" in
      CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9]|'CONIN$'|'CONOUT$'|'COM¹'|'COM²'|'COM³'|'LPT¹'|'LPT²'|'LPT³')
        echo "路徑段「${seg}」為 Windows 保留裝置名（${up}）"
        return 0 ;;
    esac
    case "$rest" in
      */*) rest="${rest#*/}" ;;
      *)   break ;;
    esac
  done
  return 1
}

# 只在有新增檔時才做（--diff-filter=AC；--no-renames 使 rename 的新路徑以 A 現身受檢）
if added="$(git -c core.quotepath=false diff --cached --name-only --no-renames --diff-filter=AC)"; then
  if [ -n "$added" ]; then
    tracked=""        # 全 repo tracked 清單只取一次（大小寫碰撞比對用）
    tracked_dirs=""   # 由 tracked 導出的「每一層目錄前綴」清單（A3 第 5 項用），同樣只算一次
    seen_dirs=""      # 已回報過的目錄前綴，避免同一次 commit 新增 N 檔就噴 N 次同一則
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # MAX_PATH 保守長度閘（A3 第 4 項，DEF-101-039）：獨立於檔名字元檢查，先行必跑。
      # 前濾零成本短路：${#f} 任一 locale 下 ≥ code point 數（UTF-8 locale＝相等、
      # C locale＝位元組數只多不少），≤180 必然合規、免 spawn（現況最長 142 → 全量零 spawn）；
      # 超標者才進精確 code point 管線＝刪去 UTF-8 連續位元組後的位元組數
      # （locale 無關，與 CI 版 len() 一致）
      if [ "${#f}" -gt 180 ]; then
        flen=$(( $(printf '%s' "$f" | LC_ALL=C tr -d '\200-\277' | wc -c) ))
        if [ "$flen" -gt 200 ]; then
          echo "[pre-commit dispatcher] ❌ 路徑過長（${flen} > 200 字元）：${f}" >&2
          echo "                        Windows MAX_PATH=260 扣除 clone 前綴預留後超限 — 修法：縮短檔名或目錄層級" >&2
          rc=1
        elif [ "$flen" -gt 180 ]; then
          echo "[pre-commit dispatcher] ⚠ 路徑偏長（${flen} > 180 字元，>200 將擋下）：${f}" >&2
        fi
      fi
      if reason="$(_ntfs_seg_bad "$f")"; then
        echo "[pre-commit dispatcher] ❌ NTFS 不相容檔名：$f — $reason" >&2
        echo "                        修法：改名後重新暫存（git mv / git rm --cached 舊名）" >&2
        rc=1
        continue
      fi
      # 大小寫碰撞：grep -iFx 對 tracked 清單做「整行、固定字串、不分大小寫」比對；
      # index 已含本次新增檔自身（原字串相同會被排除，不誤報）。grep 讀至 EOF 無 SIGPIPE 疑慮。
      if [ -z "$tracked" ]; then
        tracked="$(git -c core.quotepath=false ls-files)" || tracked=""
      fi
      collisions="$(printf '%s\n' "$tracked" | grep -iFx -e "$f" || true)"
      while IFS= read -r m; do
        [ -z "$m" ] && continue
        if [ "$m" != "$f" ]; then
          # ${f}/${m} 必須帶大括號：bash 3.2 對「$f 後緊接全形字元」的變數名邊界
          # 判定有 multibyte bug（會把後續位元組併入變數名 → unbound variable）
          echo "[pre-commit dispatcher] ❌ NTFS 大小寫碰撞：新增「${f}」與既有「${m}」僅大小寫不同" >&2
          echo "                        修法：改名避開碰撞，或先 git rm 既有路徑" >&2
          rc=1
        fi
      done <<EOF2
$collisions
EOF2
      # 目錄段層級碰撞（A3 第 5 項，R67-A2）：上一段的 grep -iFx 拿**整行**比對，對
      # 「目錄段拼法不同、basename 完全不重複」的形態結構上失明。本 repo 就是這樣長出
      # docs/04_planning/{Archive,archive}/ 與 docs/06_quality/{Archive,archive}/ 兩對
      # index 目錄並靜默共存 6 週：f81ad94 用大寫收 01–31、22782fe 改小寫收 32–50，
      # 而 mac/Windows 上兩者塌縮成同一個磁碟目錄、`git status` 全綠＝本機零訊號，
      # Linux CI／act 容器／github.com 上卻是兩個獨立目錄（真・case-sensitive APFS 卷實測）。
      # 立即危害不是覆蓋（basename 不重疊時不會），而是同一份程式碼兩平台掃到不同檔案集合、
      # 交叉引用在 Linux/github.com 變死連結。
      # bash 3.2 相容：無 assoc array／無 ${var,,}；前綴切分用 awk、折疊比對沿用 grep -iFx。
      if [ -z "$tracked_dirs" ]; then
        tracked_dirs="$(printf '%s\n' "$tracked" \
          | awk -F/ '{p="";for(i=1;i<NF;i++){p=(i==1?$i:p"/"$i);print p}}' | sort -u)"
      fi
      prefixes="$(printf '%s\n' "$f" \
        | awk -F/ '{p="";for(i=1;i<NF;i++){p=(i==1?$i:p"/"$i);print p}}')"
      while IFS= read -r d; do
        [ -z "$d" ] && continue
        # 已回報過就跳過（同時省下重複 grep）。case pattern 內的 "$d" 加引號＝字面比對。
        case $'\n'"$seen_dirs" in *$'\n'"$d"$'\n'*) continue ;; esac
        dir_collisions="$(printf '%s\n' "$tracked_dirs" | grep -iFx -e "$d" || true)"
        while IFS= read -r dm; do
          [ -z "$dm" ] && continue
          if [ "$dm" != "$d" ]; then
            # ${d}/${dm} 帶大括號：bash 3.2 對「變數後緊接全形字元」有 multibyte 變數名邊界 bug
            echo "[pre-commit dispatcher] ❌ NTFS 目錄段大小寫碰撞：新增路徑的目錄「${d}」與既有目錄「${dm}」僅大小寫不同" >&2
            echo "                        兩者在 mac/Windows 上是同一個目錄、在 Linux/github.com 上是兩個 — 修法：沿用既有拼法" >&2
            rc=1
            seen_dirs="$seen_dirs$d"$'\n'
          fi
        done <<EOF2B
$dir_collisions
EOF2B
      done <<EOF2A
$prefixes
EOF2A
    done <<EOF1
$added
EOF1
  fi
else
  # 取不到新增清單＝無法驗證正確性閘 → fail-loud（不可靜默放行）
  echo "[pre-commit dispatcher] ❌ 無法取得新增檔清單（git diff --diff-filter=AC 失敗）→ NTFS 檔名閘無法驗證，擋下" >&2
  rc=1
fi

# ── 行尾閘（R74）：進 commit 的 .sh／無副檔名 hook 檔不得含 CR ─────────────
# 🔴 為何非有這道閘不可（Windows 側對這件事**完全沒有訊號**，本輪同機實測）：
#   · Git Bash 對 CRLF 完全容忍——`bash -n` 對 CRLF 腳本 rc=0，直接執行也 rc=0 且
#     正常輸出。⇒ 下方 A4 那道 `bash -n` 看不到它（而且 A4 只掃根層基建路徑）。
#   · 同一份位元組在 POSIX bash（mac / Linux / Docker / act）上是 `$'\r': command
#     not found` ＋ syntax error。這就是「在 Windows 開發 → mac 才爆」最直接的來源。
# 🔴 為何看**暫存區 blob**（`git show :<path>`）而不是工作樹檔案：決定 mac 那邊拿到
#   什麼位元組的是入庫內容。本 repo 現況正好是這個區分的活教材——Windows checkout 上
#   有相當數量的 tracked `.sh` 工作樹是 CRLF，而 index 全部是 LF（`.gitattributes` 的
#   `*.sh text eol=lf` 正在生效，clone 到 mac 拿到的是 LF ⇒ 無危害）。看工作樹的閘門會
#   對這批檔天天假紅，看 blob 才對得上真正的危害。
#   （筆數是會漂移的量測值，刻意不寫死成本檔的常數——現查：
#    `git ls-files --eol -- '*.sh'`，看 `i/` 欄才是入庫行尾，`w/` 欄只是本機 checkout。）
# 🔴 為何有 `.gitattributes` 還要這道閘（不是重複）：那是一份**設定**。設定被削弱時
#   （新增子樹自帶 `.gitattributes` 漏了這條、或有人寫成 `*.sh -text`）CRLF 會無聲進
#   index，而 Windows 側從頭到尾零訊號，直到 mac/CI 那邊爆。內容級斷言不依賴設定是否
#   正確——這是分工：`.gitattributes` 負責「自動修正」，本閘負責「確認真的修正了」。
# 射程刻意涵蓋**全部**子專案（不像 A4 只掃根層）：CRLF 腳本在哪一棵樹都一樣會在
#   POSIX 上爆，按目錄劃界就是「鎖射程只圈一個站點」。無副檔名 hook 檔一併納入——
#   它們同樣以 bash 執行，卻沒有 `.sh` 副檔名可比對，只鎖 `*.sh` 等於只鎖一半。
# --diff-filter=ACM：刪除（D）的路徑暫存區已無 blob，`git show` 必然失敗；把那個
#   失敗讀成「驗不過」會讓任何人都不能刪腳本。
# 🔴🔴 偵測手法**不可用 grep**（本輪實測，這一步差點讓整道閘變成 Windows 上的 no-op）：
#   Git Bash（MSYS）的 grep 自己就把 CR 當行尾剝掉，`grep -qF $'\r' <CRLF檔>` 與
#   `grep -qF "$(printf '\r')" <同檔>` 在本機**雙雙 MISS**（同一支檔用 `cmp` 驗證
#   確實含 CR）。也就是說：grep 版的閘門在 Windows 上會恆綠——一道回報綠的閘門，正是
#   本閘要治的那個病本身。同款教訓已見於「Git Bash grep 讀 CP950 輸出命中 0、誤判沒有
#   失敗行」：量測載具自己會騙人，載具必須先被驗證。
#   改用「剝掉 CR 後與原檔逐位元組比對」：`tr`／`cmp` 都是位元組級，不解讀行尾語意。
# 刻意不接管線（`tr … | cmp -s - file`）：本檔檔頭記載過 `pipefail` ＋ 早退讀端的
#   SIGPIPE 陷阱；落地成第二個暫存檔再 `cmp` 兩檔，結構上就沒有管線可踩。
if eol_files="$(git -c core.quotepath=false diff --cached --name-only --no-renames --diff-filter=ACM)"; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    do_eol=0
    case "$f" in *.sh|*.bash) do_eol=1 ;; esac
    case "$f" in
      */git-hooks/*|*/.githooks/*|git-hooks/*|.githooks/*)
        # 無副檔名者才算（同目錄下的 *.py 等已由自己的政策管）
        case "${f##*/}" in *.*) : ;; *) do_eol=1 ;; esac ;;
    esac
    [ "$do_eol" -eq 1 ] || continue
    _blob="$(mktemp)"
    _blob_nocr="$(mktemp)"
    if git show ":$f" >"$_blob" 2>/dev/null; then
      LC_ALL=C tr -d '\r' <"$_blob" >"$_blob_nocr"
      if ! cmp -s "$_blob" "$_blob_nocr"; then
        # ${f} 帶大括號：bash 3.2 對「$f 後緊接全形字元」有 multibyte 變數名邊界 bug
        echo "[pre-commit dispatcher] ❌ 行尾含 CR：${f}（進 commit 的 .sh／hook 檔必須是純 LF）" >&2
        echo "                        POSIX bash（mac/Linux/Docker/act）會噴 \$'\\r' + syntax error；Windows 的 Git Bash 對此完全容忍（bash -n 亦 rc=0）＝本機零訊號" >&2
        echo "                        修法：把該檔改成 LF 後重新暫存；並確認 .gitattributes 對該路徑有 \`text eol=lf\`（正常情況下 git add 會自動正規化，需要人工修表示那條規則沒覆蓋到）" >&2
        rc=1
      fi
    else
      echo "[pre-commit dispatcher] ❌ 無法讀取暫存區內容：${f} → 行尾閘無法驗證，擋下" >&2
      rc=1
    fi
    rm -f "$_blob" "$_blob_nocr"
  done <<EOF_EOL
$eol_files
EOF_EOL
else
  # 取不到清單＝無法驗證正確性閘 → fail-loud（同上方 NTFS 閘的處置）
  echo "[pre-commit dispatcher] ❌ 無法取得暫存清單（git diff --diff-filter=ACM 失敗）→ 行尾閘無法驗證，擋下" >&2
  rc=1
fi

# ── 根層基建 leg（A4）────────────────────────────────────────────────────
# 變更清單含根層 tools/ / .gitattributes / .editorconfig / .github/ 時，對「本次變更到的」
# .sh 與無副檔名 hook 檔（tools/git-hooks/*）跑 bash -n 語法檢查（快速、零依賴）；
# 失敗擋下——根層基建自身過去零閘門，改壞 dispatcher/bootstrap 只能事後在 hook 爆炸時發現。
if [ "$run_root_infra" -eq 1 ]; then
  echo "[pre-commit dispatcher] 變更含根層基建 → bash -n 語法檢查"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      # 只檢查根層基建路徑。R56 訂正：本行原註解宣稱「子專案腳本由各自 hook
      # 把關」，實測兩子專案 pre-commit 皆未做 `.sh` 語法檢查——委派鏈是空的。
      # 兜底改由 root-infra-ci.yml 第 1 道（全庫 tracked `*.sh` 的 bash -n）承擔；
      # 此處維持只掃根層基建，是「commit 前只驗本次動到的檔、保持 hook 輕量」的
      # 刻意取捨，不是委派。
      tools/*|.github/*) : ;;
      *) continue ;;
    esac
    do_check=0
    case "$f" in *.sh) do_check=1 ;; esac
    case "$f" in
      tools/git-hooks/*)
        # 無副檔名 hook 檔（pre-commit / pre-push / post-commit …）
        case "${f##*/}" in *.*) : ;; *) do_check=1 ;; esac ;;
    esac
    if [ "$do_check" -eq 1 ] && [ -f "$TOPLEVEL/$f" ]; then
      if ! bash -n "$TOPLEVEL/$f"; then
        # ${f} 帶大括號：bash 3.2 對「$f 後緊接全形字元」有 multibyte 變數名邊界 bug
        echo "[pre-commit dispatcher] ❌ bash -n 語法檢查失敗：${f}（根層基建不可帶語法錯誤入庫）" >&2
        rc=1
      fi
    fi
  done <<EOF3
$changed
EOF3
fi

if [ "$run_autoclaude" -eq 1 ]; then
  if [ -f "$TOPLEVEL/AutoClaude/tools/git-hooks/pre-commit" ]; then
    echo "[pre-commit dispatcher] 暫存變更含 AutoClaude/ → 執行 AutoClaude pre-commit"
    bash "$TOPLEVEL/AutoClaude/tools/git-hooks/pre-commit" || rc=1
  else
    # 子 hook 應存在卻缺失＝hooks 體系損壞 → fail-loud，拒絕放行
    echo "[pre-commit dispatcher] ❌ 子 hook 缺失：$TOPLEVEL/AutoClaude/tools/git-hooks/pre-commit（hooks 體系損壞）" >&2
    rc=1
  fi
fi

if [ "$run_sdd" -eq 1 ]; then
  # AISDLC_SDD by-design 僅提供 pre-push、無 pre-commit（見檔頭設計說明）→ 不存在時正常跳過
  if [ -f "$TOPLEVEL/AISDLC_SDD/.githooks/pre-commit" ]; then
    echo "[pre-commit dispatcher] 暫存變更含 AISDLC_SDD/ → 執行 AISDLC_SDD pre-commit"
    bash "$TOPLEVEL/AISDLC_SDD/.githooks/pre-commit" || rc=1
  fi
fi

exit $rc
